script WarehouseExposedWiring {
	if (!flag (FLAG_ITEM_WAREHOUSEWIRING))
	{	msgbox(format("There's something below the exposed wiring..."))
	dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "Grab it", "Leave it alone")

	if (var(VAR_RESULT) == 0) {
	setvar(VAR_0x8004, 2)  //@ vertical pan
	setvar(VAR_0x8005, 2)  //@ horizontal pan
	setvar(VAR_0x8006, 2)  //@ num shakes
	setvar(VAR_0x8007, 4)  //@ shake delay
	special(ShakeCamera)
	playse (SE_M_THUNDERBOLT2)
	msgbox(format("Got a nasty shock...! But something else too!"))
	giveitem (ITEM_MAGNET)
	}

	else{
	msgbox(format("Better not to touch this..."))}
	}

release
}


script WarehouseExposedWiringSide {
	if (!flag (FLAG_ITEM_WAREHOUSEWIRING))
	{	msgbox(format("There's something to the side of the exposed wiring... dangerously close
	to the sparks."))}

	else{
	msgbox(format("Better not to touch this..."))}
	
	}

