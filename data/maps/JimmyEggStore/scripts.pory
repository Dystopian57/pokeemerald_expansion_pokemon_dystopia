            }

            jimmypicksupthimblereggstuff:
            msgbox(format("Now let me put everything back in place..."))
            closemessage

        
            fadescreenswapbuffers (FADE_TO_BLACK)

            playse (SE_M_STRENGTH)
            waitse
            playse (SE_M_STRENGTH)
            waitse

            //hide egg
            removeobject (13)
            setflag (thimblereggegg)

            //put decorations back in place
            clearflag (thimbleregghideobjects)
            addobject (6)
            addobject (7)
            addobject (8)
            addobject (12)

            //hide balls

            setflag (thimblereggballs)
            removeobject (14)
            removeobject (15)
            removeobject (16)

            setobjectxy (5, 4, 4)
            setobjectxy (OBJ_EVENT_ID_PLAYER, 4, 5)

            special (SpawnCameraObject)
            applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_right * 3, walk_down * 1))
            waitmovement(OBJ_EVENT_ID_CAMERA)
            special (RemoveCameraObject)

            fadeoutbgm (1)
            fadeinbgm (1)
