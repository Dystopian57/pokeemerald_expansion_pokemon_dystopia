            }

//THIMBLE VARIATION 3

		case 2:


	    playse (SE_BALL_THROW)
        applymovement (14, moves(walk_fast_down * 1, walk_fast_right * 2, walk_fast_up * 1))
        applymovement (16, moves(walk_fast_up * 1, walk_fast_left * 2, walk_fast_down * 1))
