        waitmovement (15)
        //left

        msgbox(format("Well, where is the egg?"))

		dynmultichoice(0, 0, TRUE, 3, 0, DYN_MULTICHOICE_CB_NONE,
        "Left ball", "Middle ball", "Right ball")

            if (var(VAR_RESULT) == 0) {
            playse (SE_SUCCESS)
            waitse


