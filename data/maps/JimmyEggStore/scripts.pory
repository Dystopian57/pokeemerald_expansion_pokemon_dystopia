    lock
    msgbox (format("The bucket is filling with the leakage from the pipe.\pIt's a bit disgusting..."))
    releaseall
}

script JimmyStoreEggsoncushions {
    lock
    msgbox (format("A few eggs are arranged on top of cushions."))
    releaseall
}

script JimmyStoreMoneyBags {
    lock
    msgbox (format("It's a bundle of bags, like the kind used to keep mon-..."))
    closemessage
    playse (SE_PIN)
    applymovement (5, moves(face_left, emote_exclamation_mark))
    waitmovement (5)
    msgbox (format("Hey! Don't you touch my money, or I'll put Tamarakku on you!"))
	applymovement (1, moves(face_left))
	waitmovement (1)
	playmoncry (SPECIES_TAMARAKKU, CRY_MODE_WEAK)
	msgbox (format("..."))
	applymovement (1, moves(face_down))
    applymovement (5, moves(face_down))
    waitmovement (5)
    releaseall
}