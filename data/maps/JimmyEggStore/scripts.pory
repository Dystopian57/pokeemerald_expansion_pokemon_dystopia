                playse (MUS_OBTAIN_ITEM)
                msgbox(format("Obtained the Pink Egg!"))

            }

                    if (flag (newmonabouttobesenttoPC))
                    {
                    msgbox(format("The Egg was sent to the PC."))
                    clearflag (newmonabouttobesenttoPC)	
                    }

                goto (jimmypicksupthimblereggstuff) 
                }

//THIMBLE VARIATION 2
		case 1:
	    playse (SE_BALL_THROW)
        applymovement (15, moves(walk_fast_down * 1, walk_fast_right * 1, walk_fast_up * 1))
        applymovement (16, moves(walk_fast_up * 1, walk_fast_left * 1, walk_fast_down * 1))
        waitmovement (16)

	    playse (SE_BALL_THROW)
        applymovement (15, moves(walk_fast_down * 1, walk_fast_left * 1, walk_fast_up * 1))
        applymovement (16, moves(walk_fast_up * 1, walk_fast_right * 1, walk_fast_down * 1))
        waitmovement (16)

	    playse (SE_BALL_THROW)
        applymovement (14, moves(walk_fast_down * 1, walk_fast_right * 1, walk_fast_up * 1))
