                if (var(VAR_RESULT) == 6) {
                setflag (newmonabouttobesenttoPC)}

            random (6)
            copyvar (VAR_TEMP_1, VAR_RESULT)

            switch (var(VAR_RESULT))
            {

            case 0:
                giveegg (SPECIES_TAMARAKKU)
