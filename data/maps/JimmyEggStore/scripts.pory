raw `
JimmyEggStore_MapScripts::
	.byte 0

`

script JimmyMcGligarSewersIdle {


        if (!flag(JimmySewersIntro))

        {

		if(var(VAR_JIMMYQUESTPROGRESS) == 0 && !flag(conartistaskeddistract)) //this means Player never interacted
		//with Jimmy
		{
        setvar (VAR_JIMMYQUESTPROGRESS, 4)
        setflag (JimmySewersIntro)
        goto (startJimmyStoreidle)}


		if(var(VAR_JIMMYQUESTPROGRESS) == 0 && flag(conartistaskeddistract)) //this means Jimmy asked for help
		//but player never helped him
		{

        msgbox(format("Hello there, dear custo-..."))
        closemessage
		playse (SE_PIN)
        applymovement (5, moves (emote_exclamation_mark))
        waitmovement (5)
        msgbox(format("Wait a minute. I remember you!
        \p I asked you for help on Concord Bridge, and you just waltzed away!"))

		playse (SE_M_SWAGGER2)
        applymovement (5, moves (emote_double_exclamation_mark))
        waitmovement (5)

            checkplayergender
            if(var(VAR_RESULT) == MALE){
            msgbox(format("Grr... not a man of your word, aren't you? What a shame."))
            }

            if(var(VAR_RESULT) == FEMALE){
            msgbox(format("Grr... not a woman of your word, aren't you? What a shame."))
            }

        msgbox(format("You're lucky grudges aren't profitable, or I might be showing you the door now.
        \p... well, the pipe. Same thing. Anyhow..."))
        setvar (VAR_JIMMYQUESTPROGRESS, 4)
        setflag (JimmySewersIntro)
        goto (startJimmyStoreidle)
        }

	    if(var(VAR_JIMMYQUESTPROGRESS) == 1 && flag(conartistescaped) && flag(!betrayedconcordconartist)) //this means Player helped Jimmy but cleared Warehouse
		//before getting reward from Jimmy, so he gives Tamarakku egg: "I never thanked you!"
		{
        msgbox(format("Well well, if it isn't my personal saviour, AND favourite customer!
        \pYou're such a good samaritan, you helped me without coming to claim the reward I promised
        you!\pBut Jimmy McGligar is a man of his word - and here's the proof!"))

        giveegg (SPECIES_TAMARAKKU)
        fadeoutbgm (1)
        playse (MUS_OBTAIN_ITEM)
        msgbox(format("Obtained the Mysterious Egg!"))

        msgbox(format("There you go - I'm sure it'll hatch into a strong, healthy baby!
        \pAnd if you're interested in more, well... you're in the right place!"))
        setvar (VAR_JIMMYQUESTPROGRESS, 4)
        setflag (JimmySewersIntro)
        goto (startJimmyStoreidle)   
        }

	    if(var(VAR_JIMMYQUESTPROGRESS) == 2 && flag(conartistescaped) && flag(helpedconcordconartist))
        //this means Player helped Jimmy and obtained egg
		{
      	playse (SE_PIN)
        applymovement (5, moves (emote_exclamation_mark))
        waitmovement (5)
        msgbox(format("Well well, if it isn't my personal saviour! Glad you found my humble place!
        \pI wouldn't be here if it wasn't for you, so please, make yourself at sewer!"))
        setvar (VAR_JIMMYQUESTPROGRESS, 4)
        setflag (JimmySewersIntro)
        goto (startJimmyStoreidle)    
        }

	    if(var(VAR_JIMMYQUESTPROGRESS) == 2 && flag(conartistescaped) && flag(betrayedconcordconartist))
        //this means Player betrayed Jimmy
		{
		playse (SE_PIN)
        applymovement (5, moves (emote_exclamation_mark))
        waitmovement (5)
        msgbox(format("Hey, it's YOU! You damn kid!"))
 		playse (SE_M_SWAGGER2)
        applymovement (5, moves (emote_double_exclamation_mark))
        waitmovement (5)
        msgbox(format("You really played a number on me back on Concord Bridge!
        \pI should kick you right out of my shop for it. But… I'll confess...
        \pThat was the first time someone tricked ME. And part of me respects that.
        \pWhat say we let bygone be bygones? Water under the Concord Bridge!
        \pBut I warn you. Fool me once, that's alright..."))
        applymovement (5, moves (face_left))
        waitmovement (5)
        msgbox(format("Fool me twice, I'll throw this fella at your throat."))
 		playse (SE_LEDGE)
        applymovement (1, moves (jump_in_place_down))
        waitmovement (1)
        playmoncry (SPECIES_TAMARAKKU, CRY_MODE_WEAK)

        applymovement (5, moves (face_player))
        waitmovement (5)
        msgbox(format("Anyhow..."))
        setvar (VAR_JIMMYQUESTPROGRESS, 4)
        setflag (JimmySewersIntro)
        goto (startJimmyStoreidle)
        }	

	    if(var(VAR_JIMMYQUESTPROGRESS) == 3)
	    //Player helped Jimmy and even bought Exeggcute egg
        {
      	playse (SE_PIN)
        applymovement (5, moves (emote_exclamation_mark))
        waitmovement (5)
        msgbox(format("Well well, if it isn't my personal saviour AND favourite customer!
        \pI wouldn't be here if it wasn't for you, so please, make yourself at sewer!"))
        setvar (VAR_JIMMYQUESTPROGRESS, 4)
        setflag (JimmySewersIntro)
        goto (startJimmyStoreidle)  
        }

		//regardless of result, setvar (VAR_JIMMYQUESTPROGRESS, 4)




        }

        startJimmyStoreidle:
        msgbox(format("Welcome to Jimmy's Egg Store - Where Happiness Hatches!
        \pWhat can I do for you, oh dear customer?"))

        eggsell:
		dynmultichoice(0, 0, TRUE, 4, 0, DYN_MULTICHOICE_CB_NONE, "Buy an egg", "Play Thimbleregg", "Egg Store?", "Leave")


		if (var(VAR_RESULT) == 3) {
        msgbox(format("Well, maybe some other time!
        {COLOR LIGHT_GRAY}{SHADOW WHITE}Cheapstake...{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}"))
        goto (endofjimmystoreidle)
        }

		if (var(VAR_RESULT) == 0) {
        msgbox(format("Sure thing - it's only 1000¥ each! The species is a surprise!"))

        		checkmoney (1000)
				if (var(VAR_RESULT) == TRUE) {
    	        showmoneybox (18, 0)

                dynmultichoice(0, 0, TRUE, 6, 0, DYN_MULTICHOICE_CB_NONE,
                "Cracked Egg",
                "Bundle Egg",
                "Moon Egg",
                "Sun Egg",
                "Flower Egg",
                "Pink Egg",
                "Nevermind")

            		if (var(VAR_RESULT) == 6) {
                    msgbox(format("Well, maybe some other time!
                    {COLOR LIGHT_GRAY}{SHADOW WHITE}Cheapstake...{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}"))
                    goto (endofjimmystoreidle)
                    }

            		if (var(VAR_RESULT) == 0) {

                    specialvar (VAR_RESULT, CalculatePlayerPartyCount)
                    if (var(VAR_RESULT) == 6) {
                    setflag (newmonabouttobesenttoPC)
					removemoney (1000)
                    updatemoneybox
					playse (SE_SHOP)
					waitse
					hidemoneybox

                    giveegg (SPECIES_TAMARAKKU)
                    playse (MUS_OBTAIN_ITEM)
                    msgbox(format("Obtained the Cracked Egg!"))

                    }
                    }
                    if (var(VAR_RESULT) == 1) {

                    specialvar (VAR_RESULT, CalculatePlayerPartyCount)
                    if (var(VAR_RESULT) == 6) {
                    setflag (newmonabouttobesenttoPC)
					removemoney (1000)
                    updatemoneybox
					playse (SE_SHOP)
					waitse
					hidemoneybox

                    giveegg (SPECIES_EXEGGCUTE)
                    playse (MUS_OBTAIN_ITEM)
                    msgbox(format("Obtained the Bundle Egg!"))     

                    }               
                    }

                    if (var(VAR_RESULT) == 2) {

                    specialvar (VAR_RESULT, CalculatePlayerPartyCount)
                    if (var(VAR_RESULT) == 6) {
                    setflag (newmonabouttobesenttoPC)
					removemoney (1000)
                    updatemoneybox
					playse (SE_SHOP)
					waitse
					hidemoneybox

                    giveegg (SPECIES_TEDDIURSA)
                    playse (MUS_OBTAIN_ITEM)
                    msgbox(format("Obtained the Moon Egg!"))     

                    }   

                    }
                    if (var(VAR_RESULT) == 3) {

                    specialvar (VAR_RESULT, CalculatePlayerPartyCount)
                    if (var(VAR_RESULT) == 6) {
                    setflag (newmonabouttobesenttoPC)
					removemoney (1000)
                    updatemoneybox
					playse (SE_SHOP)
					waitse
					hidemoneybox

                    giveegg (SPECIES_HELIOPTILE)
                    playse (MUS_OBTAIN_ITEM)
                    msgbox(format("Obtained the Sun Egg!"))     

                    }   

                    }
                    if (var(VAR_RESULT) == 4) {

                    specialvar (VAR_RESULT, CalculatePlayerPartyCount)
                    if (var(VAR_RESULT) == 6) {
                    setflag (newmonabouttobesenttoPC)
					removemoney (1000)
                    updatemoneybox
					playse (SE_SHOP)
					waitse
					hidemoneybox

                    giveegg (SPECIES_FOMANTIS)
                    playse (MUS_OBTAIN_ITEM)
                    msgbox(format("Obtained the Flower Egg!"))     

                    }   

                    }
                    if (var(VAR_RESULT) == 5) {


                    specialvar (VAR_RESULT, CalculatePlayerPartyCount)
                    if (var(VAR_RESULT) == 6) {
                    setflag (newmonabouttobesenttoPC)
					removemoney (1000)
                    updatemoneybox
					playse (SE_SHOP)
					waitse
					hidemoneybox

                    giveegg (SPECIES_HAPPINY)
                    playse (MUS_OBTAIN_ITEM)
                    msgbox(format("Obtained the Pink Egg!"))     

                    }   

                    }

                    if (flag (newmonabouttobesenttoPC))
                    {
                    msgbox(format("The Egg was sent to the PC."))
                    clearflag (newmonabouttobesenttoPC)	
                    }

                    msgbox(format("Thank you for your patronage - you take good care of that hatchling now!"))                
                    goto (endofjimmystoreidle)
			}


				if (var(VAR_RESULT) == FALSE) {

                closemessage
                playse (SE_PIN)
                applymovement (5, moves (emote_exclamation_mark))
                waitmovement (5)
                msgbox(format("Wait a minute... I can smell it on you. You ain't got enough dough!
                \pParenting takes money you know? You sort your financials before coming back!"))
                goto (endofjimmystoreidle)

                }

        }

		if (var(VAR_RESULT) == 1) {

        if (flag(dailythimbleregg))

            {msgbox(format("Oh, I'm sorry dear customer - only one Thimbleregg round per day!
            \pI've got some customers addicted to the thrilling gambling rush, and it's not a
            pleasant experience.\pSo come back tomorrow - I'll be happy to play then!"))
            goto (endofjimmystoreidle)
            }

        checkplayergender
        if(var(VAR_RESULT) == MALE){
        msgbox(format("Thumbleregg? You're on, lad! Let me get everything ready..."))
        }

        checkplayergender
        if(var(VAR_RESULT) == FEMALE){
        msgbox(format("Thumbleregg? You're on, lass! Let me get everything ready..."))
        }
        closemessage

        fadescreenswapbuffers (FADE_TO_BLACK)

        //hide decorations to make room for thimbleregg
        setflag (thimbleregghideobjects)
        removeobject (6)
        removeobject (7)
        removeobject (8)
        removeobject (12)

        //add balls

        clearflag (thimblereggballs)
        addobject (14)
        addobject (15)
        addobject (16)

        setobjectxy (5, 1, 3)
        setobjectxy (OBJ_EVENT_ID_PLAYER, 1, 5)

		special (SpawnCameraObject)
		applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_left * 3, walk_up * 1))
    	waitmovement(OBJ_EVENT_ID_CAMERA)
		special (RemoveCameraObject)

        fadeoutbgm (1)
        fadeinbgm (1)
        playbgm (MUS_TRICK_HOUSE, TRUE)

        fadescreenswapbuffers (FADE_FROM_BLACK)



        msgbox(format("Alright, eyes sharp now! Guess inside which ball is the egg, and get
        that egg as a prize!"))

        playse (SE_BALL_OPEN)
        removeobject (15)
        clearflag (thimblereggegg)
        addobject (13)
        waitse
        addobject (15)

        playse (SE_BALL_TRADE)
        setflag (thimblereggegg)
        removeobject (13)
        waitse



		random (3)
		copyvar (VAR_TEMP_1, VAR_RESULT)

		switch (var(VAR_RESULT))
		{
            
//THIMBLE VARIATION 1    
        case 0:
        temporarythimblecommonstart:

	    playse (SE_BALL_THROW)
        applymovement (15, moves(walk_fast_down * 1, walk_fast_left * 1, walk_fast_up * 1))
        applymovement (14, moves(walk_fast_up * 1, walk_fast_right * 1, walk_fast_down * 1))
        waitmovement (14)

	    playse (SE_BALL_THROW)
        applymovement (14, moves(walk_fast_down * 1, walk_fast_right * 1, walk_fast_up * 1))
        applymovement (16, moves(walk_fast_up * 1, walk_fast_left * 1, walk_fast_down * 1))
        waitmovement (16)

	    playse (SE_BALL_THROW)
        applymovement (14, moves(walk_fast_down * 1, walk_fast_left * 2, walk_fast_up * 1))
        applymovement (15, moves(walk_fast_up * 1, walk_fast_right * 2, walk_fast_down * 1))
        waitmovement (16)
        //egg is on the right ball

        msgbox(format("Well, where is the egg?"))

		dynmultichoice(0, 0, TRUE, 3, 0, DYN_MULTICHOICE_CB_NONE,
        "Left ball", "Middle ball", "Right ball")

            if (var(VAR_RESULT) == 0) {
            wrongthimblereggeggitsinright:
            playse (SE_RG_HELP_ERROR)
            msgbox(format("Nope!"))

            playse (SE_BALL_OPEN)

            removeobject (15)
            addobject (13)
            setobjectxy (13, 2, 4)
            clearflag (thimblereggegg)

            waitse
            addobject (15)

            msgbox(format("It was on the right ball! Better luck next time!")) 
            goto (jimmypicksupthimblereggstuff) 

            }

            if (var(VAR_RESULT) == 1) {
            goto (wrongthimblereggeggitsinright)

            }

            if (var(VAR_RESULT) == 2) {

            playse (SE_SUCCESS)
            waitse


            playse (SE_BALL_OPEN)

            removeobject (15)
            addobject (13)
            setobjectxy (13, 2, 4)
            clearflag (thimblereggegg)
            

            waitse
            msgbox(format("Good job! You guessed right - here's your egg!"))



                specialvar (VAR_RESULT, CalculatePlayerPartyCount)
                if (var(VAR_RESULT) == 6) {
                setflag (newmonabouttobesenttoPC)}

            random (6)
            copyvar (VAR_TEMP_1, VAR_RESULT)

            switch (var(VAR_RESULT))
            {

            case 0:
                giveegg (SPECIES_TAMARAKKU)
                playse (MUS_OBTAIN_ITEM)
