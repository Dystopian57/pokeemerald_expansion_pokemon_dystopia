            }


		if (var(VAR_RESULT) == 2) {
        msgbox(format("Why, I think it's rather self-explanatory - but I'm happy to tell you a bit more.
        \pThese days, only Devon Breeders are legally allowed to breed Pokémon, and handle their offspring.
        \pAnyone else who gets caught
        doing it... it's a heavy fine in the best of cases, and Dewford Prison in the worst.
        \pDevon Co. only want Safemon inhabiting routes, and regular Pokémon
        reproduction goes against that goal.
        \pBut you know Pokémon - and hell, humans too.\pThey're gonna screw no matter what. Bwahaha!
        \pWhen they do, keeping the egg is just asking for legal trouble.\pAnd that's where yours truly in!
        \pI take these eggs off people, and give them a new home. Simple as that.
        \pIllegal? Maybe. Moral? Probably. Profitable? Very!
        \pSpeaking of profit, I ain't running a DLC here, so...
        \pWanna buy an egg?"))
        goto (eggsell)
        }

        

    endofjimmystoreidle:
    release
}


script JimmyTamarakkuIdle {
	lock
	applymovement (1, moves(face_player))
	waitmovement (1)
	playmoncry (SPECIES_TAMARAKKU, CRY_MODE_WEAK)
	msgbox (format("..."))
	applymovement (1, moves(face_down))
	waitmovement (1)
	release
}

script JimmyKecleonIdle {
	lock
	applymovement (7, moves(face_player))
	waitmovement (7)
	playmoncry (SPECIES_KECLEON, CRY_MODE_NORMAL)
	msgbox (format("Ke-keeee!
    \pThe Kecleon seems to be looking for Ninkaburi to eat."))
	release
}

script JimmyGachapodIdle {
	lock
	applymovement (6, moves(face_player))
	waitmovement (6)
	playmoncry (SPECIES_GACHAPOD, CRY_MODE_WEAK)
	msgbox (format("{COLOR LIGHT_GRAY}{SHADOW WHITE}Ga-gaaa...!{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}"))
	release
}

script JimmyStoreBoxItem {
	lock
	if (!flag (jimmystoreboxitem))
	{
	msgbox(format("There's something inside the box..."))
	giveitem (ITEM_OVAL_CHARM)
	setflag (jimmystoreboxitem)}

	else {msgbox(format("There's nothing inside the box."))}
	release
}


script JimmyStoreBriefcase {
    lock
    msgbox (format("An inconspicuous briefcase, worn with use."))
    releaseall
}

script JimmyStoreTamarakkudoll {
    lock
    msgbox (format("A Tamarakku doll. It's a bit creepy."))
    releaseall
}

