raw `


`
mapscripts PastLittlerootTown_MapScripts {
    MAP_SCRIPT_ON_LOAD: LoadPastSprite
	//MAP_SCRIPT_ON_TRANSITION: PastSpriteSwapTrick
}

script LoadPastSprite {

		checkplayergender
			if(var(VAR_RESULT) == MALE){
            setflag (pastplayerf)
            }

			if(var(VAR_RESULT) == FEMALE){
            setflag (pastplayerm)
            }
}

script PastOutsideTrigger {

    setvar (VAR_FLASHBACK_DREAM, 2)

}

script PastNightmareZoneReturn {
    
    lock
	msgbox (format("... must find dad."))
	applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_up * 1))
    waitmovement (OBJ_EVENT_ID_PLAYER)
    release

}

script PastNightmareZoneTrigger {

    setvar (VAR_FLASHBACK_DREAM, 3)

}

script PastShadeWeather {
lock
setweather (WEATHER_SHADE)
doweather
fadeoutbgm (1)
playbgm (MUS_WEATHER_GROUDON, FALSE)
release
}

