raw `

Route102_EventScript_LittleBoy::
	msgbox Route102_Text_ImNotVeryTall, MSGBOX_NPC
	end

Route102_EventScript_RouteSignOldale::
	msgbox Route102_Text_RouteSignOldale, MSGBOX_SIGN
	end

Route102_EventScript_RouteSignPetalburg::
	msgbox Route102_Text_RouteSignPetalburg, MSGBOX_SIGN
	end

Route102_EventScript_Boy::
	msgbox Route102_Text_CatchWholeBunchOfPokemon, MSGBOX_NPC
	end
	
Route102_EventScript_Calvin::
	trainerbattle_single TRAINER_CALVIN_1, Route102_Text_CalvinIntro, Route102_Text_CalvinDefeated, Route102_EventScript_CalvinRegisterMatchCallAfterBattle
	specialvar VAR_RESULT, ShouldTryRematchBattle
	goto_if_eq VAR_RESULT, TRUE, Route102_EventScript_CalvinRematch
	setvar VAR_0x8004, TRAINER_CALVIN_1
	specialvar VAR_RESULT, IsTrainerRegistered
	goto_if_eq VAR_RESULT, FALSE, Route102_EventScript_CalvinTryRegister
	msgbox Route102_Text_CalvinPostBattle, MSGBOX_DEFAULT
	release
	end

Route102_EventScript_CalvinRegisterMatchCallAfterBattle::
	special PlayerFaceTrainerAfterBattle
	waitmovement 0
	goto_if_set FLAG_HAS_MATCH_CALL, Route102_EventScript_CalvinRegisterMatchCall
	release
	end

Route102_EventScript_CalvinRegisterMatchCall::
	msgbox Route102_Text_CalvinRegisterShort, MSGBOX_DEFAULT
	register_matchcall TRAINER_CALVIN_1
	release
	end

Route102_EventScript_CalvinTryRegister::
	goto_if_set FLAG_HAS_MATCH_CALL, Route102_EventScript_CalvinRegister
	msgbox Route102_Text_CalvinPostBattle, MSGBOX_DEFAULT
	release
	end

Route102_EventScript_CalvinRegister::
	msgbox Route102_Text_CalvinRegister, MSGBOX_DEFAULT
	register_matchcall TRAINER_CALVIN_1
	release
	end

Route102_EventScript_CalvinRematch::
	trainerbattle_rematch TRAINER_CALVIN_1, Route102_Text_CalvinRematchIntro, Route102_Text_CalvinRematchDefeated
	msgbox Route102_Text_CalvinRematchPostBattle, MSGBOX_AUTOCLOSE
	end

Route102_EventScript_Rick::
	trainerbattle_single TRAINER_RICK, Route102_Text_RickIntro, Route102_Text_RickDefeated
	msgbox Route102_Text_RickPostBattle, MSGBOX_AUTOCLOSE
	end

Route102_EventScript_Tiana::
	trainerbattle_single TRAINER_TIANA, Route102_Text_TianaIntro, Route102_Text_TianaDefeated
	msgbox Route102_Text_TianaPostBattle, MSGBOX_AUTOCLOSE
	end

Route102_EventScript_Allen::
	trainerbattle_single TRAINER_ALLEN, Route102_Text_AllenIntro, Route102_Text_AllenDefeated
	msgbox Route102_Text_AllenPostBattle, MSGBOX_AUTOCLOSE
	end

Route102_Text_WatchMeCatchPokemon:
	.string "WALLY: {PLAYER}…\n"
	.string "POKéMON hide in tall grass like this,\l"
	.string "don't they?\p"
	.string "Please watch me and see if I can\n"
	.string "catch one properly.\p"
	.string "…Whoa!$"

Route102_Text_WallyIDidIt:
	.string "WALLY: I did it… It's my…\n"
	.string "My POKéMON!$"

Route102_Text_LetsGoBack:
	.string "{PLAYER}, thank you!\n"
	.string "Let's go back to the GYM!$"

Route102_Text_ImNotVeryTall:
	.string "I'm…not very tall, so I sink right\n"
	.string "into tall grass.\p"
	.string "The grass goes up my nose and…\n"
	.string "Fwafwafwafwafwa…\p"
	.string "Fwatchoo!$"

Route102_Text_CatchWholeBunchOfPokemon:
	.string "I'm going to catch a whole bunch of\n"
	.string "POKéMON!$"

Route102_Text_RouteSignOldale:
	.string "ROUTE 102\n"
	.string "{RIGHT_ARROW} OLDALE TOWN$"

Route102_Text_RouteSignPetalburg:
	.string "ROUTE 102\n"
	.string "{LEFT_ARROW} PETALBURG CITY$"

`


mapscripts Route102_MapScripts {
    //MAP_SCRIPT_ON_TRANSITION: Route102Weather
    MAP_SCRIPT_ON_LOAD: Route102Weather
	MAP_SCRIPT_ON_LOAD: PopWeatherMon102
	MAP_SCRIPT_ON_LOAD: DynamicWeather102}

script DynamicWeather102 {
		if (var(VAR_ROUTE102_WEATHER) == 0)
		{random (10)
		copyvar (VAR_TEMP_1, VAR_RESULT)

		switch (var(VAR_RESULT))
		{case 0: goto (Route102EndSandtorm)
		case 1: goto (Route102EndSandtorm)
		case 2: goto (Route102Shade)
		case 3: goto (Route102Shade)
		case 4: goto (Route102Shade)
		case 5: goto (Route102Shade)
		case 6: goto (Route102Shade)
		case 7: goto (Route102Shade)
		case 8: goto (Route102Shade)
		case 9: goto (Route102Shade)
		case 10: goto (Route102Shade)
		}}
}

script Route102Weather {

			goto_if_eq (VAR_ROUTE102_WEATHER, 0, Route102Shade)
			goto_if_eq (VAR_ROUTE102_WEATHER, 1, Route102Sandstorm1)
			goto_if_eq (VAR_ROUTE102_WEATHER, 2, Route102Sandstorm2)
			goto_if_eq (VAR_ROUTE102_WEATHER, 3, Route102EndSandtorm)

	release
}

script Route102Shade {
	setweather (WEATHER_SHADE)
}

script Route102Sandstorm1 {
	setweather (WEATHER_SANDSTORM)
	setvar(VAR_ROUTE102_WEATHER, 2)
	playbgm (MUS_RUINSMUSIC, TRUE)
}

script Route102Sandstorm2 {
	setweather (WEATHER_SANDSTORM)
	setvar(VAR_ROUTE102_WEATHER, 3)
	playbgm (MUS_RUINSMUSIC, TRUE)
}

script Route102EndSandtorm {
	setweather (WEATHER_SANDSTORM)
	setvar(VAR_ROUTE102_WEATHER, 0)
	playbgm (MUS_RUINSMUSIC, TRUE)
}

script PopWeatherMon102 {
	//if (var(VAR_ROUTE102_WEATHER) == 0)
	//{setflag (route102weathermon)}

	//if (var(VAR_ROUTE102_WEATHER) == 1)
	//{clearflag (route102weathermon)}

	//if (var(VAR_ROUTE102_WEATHER) == 2)
	//{clearflag (route102weathermon)}

	if (var(VAR_ROUTE102_WEATHER) == 3)
	{clearflag (route102weathermon)}

	}





script BridgeItem {
	lockall
	if (!flag (FLAG_ITEM_PLAYER1F_RATION))
	{giveitem (ITEM_ENERGY_ROOT, 3)
	setflag (FLAG_ITEM_PLAYER1F_RATION)
    removeobject (8)}
	else
	{msgbox (format("The box is empty."))
	releaseall
}}



script Route102Weathermon {
	lock
	setflag (FLAG_SAFE_FOLLOWER_MOVEMENT)
	applymovement (8, moves(face_player))
    msgbox (format("The Sandshrew is just enjoying the sandstorm. Battle it?"))
	dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "Yes", "No")

	if (var(VAR_RESULT) == 0) {
	waitmessage
	setwildbattle(SPECIES_SANDSHREW, 3)
	dowildbattle
	specialvar(VAR_RESULT, GetBattleOutcome)
	if(var(VAR_RESULT) == B_OUTCOME_CAUGHT){
		setflag (route102weathermon)
	}
	elif(var(VAR_RESULT) == B_OUTCOME_WON){
		goto (endsandshrewinsandstormscript)
		setflag (route102weathermon)
	}
	elif(var(VAR_RESULT) == B_OUTCOME_RAN){
		goto (endsandshrewinsandstormscript)
	}
	elif(var(VAR_RESULT) == B_OUTCOME_PLAYER_TELEPORTED){
		goto (endsandshrewinsandstormscript)
	}

	}

	if (var(VAR_RESULT) == 1) {
		goto (endsandshrewinsandstormscript)
	}

	endsandshrewinsandstormscript:
	waitmessage
	release
}

script Route103ScientistFoundTracks {
	    lock
	    setflag (FLAG_SAFE_FOLLOWER_MOVEMENT)

        playse (SE_PIN)
        applymovement (OBJ_EVENT_ID_NPC_FOLLOWER, moves(face_player, emote_exclamation_mark))

        msgbox(format("Halt a moment, my dear fellow! Those marks on the ground..."))

        applymovement (OBJ_EVENT_ID_PLAYER, moves(walk_up * 3, face_right))
        applymovement (OBJ_EVENT_ID_NPC_FOLLOWER, moves(walk_up * 3, face_right))
		waitmovement (OBJ_EVENT_ID_NPC_FOLLOWER)

        msgbox(format("As I thought... they are the
		unmistakable footprints of a Keckleon!\p Certainly not the Pokémon we are looking for - in fact,
		I was not even aware they lived in these parts...\p And that, in itself, is a promising lead.\p
		Pray follow the tracks, for they may lead us to a yet uncharted spot."))
        setvar(VAR_102_SCIENTIST, 2)
		release
		}

script Route102Scientist {
	    lock
	    setflag (FLAG_SAFE_FOLLOWER_MOVEMENT)

        if(var(VAR_102_SCIENTIST) == 1){
        msgbox(format("You are returned, which fills my heart with renewed hope!\pWill you assist me
		with the search of the to-be-Safened Pokémon?"))
		goto (scientistasksforhelp102)
		}

        if(var(VAR_102_SCIENTIST) == 0){
        setvar(VAR_102_SCIENTIST, 1)
        msgbox(format("Where is it, where is it...?"))
        playse (SE_PIN)
        applymovement (7, moves(face_player, emote_exclamation_mark))
        checkplayergender
        if(var(VAR_RESULT) == MALE){
		msgbox(format("Oh, hello there lad. I thought they had enclosed the road for me..."))}

        if(var(VAR_RESULT) == FEMALE){
		msgbox(format("Oh, hello there lad. I thought they had enclosed the road for me..."))}

        msgbox(format("But this is most fortunate. You see, I work for Devon Co.'s Safemon
		Department.\p I am here to acquire a dangerous Pokémon specimen, so that we at Devon Co.
		may study it and convert it into a Safemon.\p Only thing is, this specimen possesses
		telepathic powers."))

        applymovement (7, moves(face_away_player))

        msgbox(format("I theorize it's reading in my mind the desire to capture and study it, and thus
		giving me a wide berth."))

        applymovement (7, moves(face_player))

        msgbox(format("Luckily, according to my theory, if I were to follow someone who
		harbors no such desire...\pThen my thoughts may be cloaked behind theirs, and the
		Pokémon may reveal itself.
		\p You, who seem of rather... absent mind, should prove the perfect candidate to test my
		theory.\p I am therefore compelled to ask for your assistance.\pI would duly compensate
		you for your time, of course."))

		scientistasksforhelp102:
		dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "Help", "Don't help")
        if(var(VAR_RESULT) == 0){msgbox(format("That's splendid! Together we shall take the next
		step to make Hoenn a safer place.\p Lead the way then, kind youth. I shall follow.\p Ah, and
		pray do not waste time combing through the tall grass or the deep sand.\p I have found no footprints
		of the specimen in these places, and thus I conclude its lair must be in a secret enclave I am yet
		to discover."))
		
		setfollowernpc (LOCALID_102_RESEARCHER, FNPC_ALL, Route102Scientistfollowchat, 0)
        removeobject (7)
        setflag (researcher102)
		}

        if(var(VAR_RESULT) == 1){
        msgbox(format("Ah, most unfortunate... but I understand.\p You must be in a hurry, or have
		moral concerns.\pStill, if you were to reconsider, I would be most grateful, for this road
		is barely transited.\pIf you change your mind, let us rendezvous here anew. Take care."))
		}}


release

}

script Route102Scientistfollowchat {
        lock
		applymovement (OBJ_EVENT_ID_FOLLOWER, moves(face_player))

        msgbox(format("Yes? What is it, my young helper?"))

		dynmultichoice(0, 0, TRUE, 5, 0, DYN_MULTICHOICE_CB_NONE, "Where to?", "Which Pokémon is it?","All good?", "I'm leaving", "Nevermind")
        if(var(VAR_RESULT) == 0){
        msgbox(format("I wish I could offer such guidance. All I can say is I have examined all
		the spots where Pokémon live in the vicinity.\p ... barring, that is, the half-built,
		man-made structures.\pCould it have been a flagrant oversight...?"))
		}

        if(var(VAR_RESULT) == 1){
        msgbox(format("Of course, how oblivious of me... the Pokémon I am looking for is a Ralts.\pI
		have been told certain speciments of this species underwent a dangerous mutation after the war,
		so its Safening is of the utmost priority."))

			if (flag (FLAG_SYS_POKEDEX_GET))
			{msgbox(format("I see you possess a Devon Dex. Let me register the Pokémon's visual
			data in it."))
			closemessage
			
			playse (SE_DEX_SCROLL)
			waitse
			playse (SE_DEX_SCROLL)
			waitse
			playse (SE_DEX_SEARCH)
			waitse
			playse (SE_DEX_PAGE)
			waitse

			setseenmon (SPECIES_WARTZ)

			msgbox(format("You should be able to see it now. It may prove paramount in the search."))
			
			}

		}

        if(var(VAR_RESULT) == 2){
        msgbox(format("Ah, it's kind of you to worry about me. Possibly on account of my age?\p
		They warned me of the... 'contrarian' disposition of the inhabitans of these parts. \pBut
		it seems said concerns were based on foundless prejudice.\p To answer your question - I am
		hale. Let us continue our search."))
		}

        if(var(VAR_RESULT) == 3){
        msgbox(format("Truly? That's most regrettable... I felt we were quite close to our goal.
		\p I appreciate your time nonetheless. If you can spare some more, I shall be where
		we first met."))

		fadescreenswapbuffers (FADE_TO_BLACK)
        destroyfollowernpc
        addobject (7)
        clearflag (researcher102)
		fadescreenswapbuffers (FADE_FROM_BLACK)
        setvar(VAR_102_SCIENTIST, 0)


		}

        if(var(VAR_RESULT) == 3){
        msgbox(format("Pray do not dispair. We shall find the specimen in time."))
		}

		release
		}