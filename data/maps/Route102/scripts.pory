	script Route102ScammerApproach0 {
		lock
		setflag (FLAG_SAFE_FOLLOWER_MOVEMENT)
		playse (SE_PIN)
		applymovement (10, moves(emote_exclamation_mark))
		waitmovement (10)
		msgbox (format("Woah there friend! Where are you going so fast?\pSettle down, enjoy life a
		little!"))
		goto (route102scammerafterapproach)
		
		}

	script Route102ScammerApproach1 {
