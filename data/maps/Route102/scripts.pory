	script Route102Scammer {
		lock
		setflag (FLAG_SAFE_FOLLOWER_MOVEMENT)
		applymovement (10, moves(face_player))
		waitmovement (10)

		if ((var(VAR_102CANDYSCAMMER) == 0 ))
		{

		msgbox (format("Woah there friend! Where are you going so fast?\pSettle down, enjoy life a
		little!"))
		route102scammerafterapproach:
		closemessage
        applymovement (OBJ_EVENT_ID_PLAYER, moves(face_up))
		waitmovement (OBJ_EVENT_ID_PLAYER)
		msgbox (format("Say, what about a Rare Candy to sweeten your day?\pIt'll make your
		Pokémon stronger! 500¥ each!"))
		scammer102candybuychoice:
    	showmoneybox (18, 0)
		dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "Buy one", "Don't buy")
			if (var(VAR_RESULT) == 0) {
					checkmoney (500)
					if (var(VAR_RESULT) == TRUE) {
						removemoney (500)
						updatemoneybox
						playse (SE_SHOP)
						waitse
						hidemoneybox
						
						msgbox (format("Thank you for your purchase - here you go!"))
						giveitem (ITEM_EXP_CANDY_XS)
						msgbox (format("Let me know how your Pokémon like it!"))
						setflag (boughtrarecandyfrom102scammer)
					setvar (VAR_102CANDYSCAMMER, 1)
					clearflag (devonreturnstooldale)
					clearflag (warehousemanagerandabra)
					setflag (warehousemanchine)
					setflag (FLAG_ITEM_WAREHOUSEMONEYBAGS)
						goto (endofroute102scammer)
						
						}
					if (var(VAR_RESULT) == FALSE) {
						msgbox (format("What... you don't even have 500¥ on you pal?\pSucks to be you!
						Hey, free advice: I heard the Devon staff is back at Oldale Warehouse.\pMaybe
						you can get a job there!"))
						goto (endofroute102scammer)
					}
				
					}

			if (var(VAR_RESULT) == 1) {
						hidemoneybox
						msgbox (format("You're going to let this chance pass by? Well... your loss!"))
					setvar (VAR_102CANDYSCAMMER, 1)
					clearflag (devonreturnstooldale)
					clearflag (warehousemanagerandabra)
					setflag (warehousemanchine)
					setflag (FLAG_ITEM_WAREHOUSEMONEYBAGS)
						goto (endofroute102scammer)
			}


		
		}

  	if ((var(VAR_102CANDYSCAMMER) == 1 ))
	{		

		if (!flag(confronted102candyscammer))

		{if ((flag(boughtrarecandyfrom102scammer)) && checkitem (ITEM_EXP_CANDY_XS)  == TRUE)
		{
		msgbox (format("You still have that candy on you eh? Saving it for a special occassion?"))	
		goto (endofroute102scammer)	
		}

		if ((flag(boughtrarecandyfrom102scammer)) && checkitem (ITEM_EXP_CANDY_XS)  == FALSE)
		{
		msgbox (format("Hm? What's wrong? You look disappointed."))
		dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "You're a scammer!", "It's nothing")
			if (var(VAR_RESULT) == 0) {
			
			msgbox (format("Woah there pal - that's some serious accusation! What do you mean!?"))
				dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "It only healed 1 HP", "Forget about it")
						if (var(VAR_RESULT) == 0) {
						msgbox (format("1 HP? And what is an “HP” exactly? What? “Health Points” you say?
						\pListen kid, I don't have the foggiest of what you're talking about.
						\pYou're saying you can SEE a Pokémon's health in NUMBERS?
						\pThat's stupid. This isn't a videogame! But Pokémon get stronger with these candies!
						\pIf you can't tell the difference, it just
						means you need to feed them more candies!"))
						setflag (confronted102candyscammer)
						goto (endofroute102scammer)
						}
						if (var(VAR_RESULT) == 1) {
						msgbox (format("Bah, stop messing around, I have no time for jokes!"))
						goto (endofroute102scammer)
						}

			}

			if (var(VAR_RESULT) == 1) {
			msgbox (format("Well, then be on your way. I'm on the lookout for customers!"))
			goto (endofroute102scammer)
			}
		}

		}
		
		else {
			msgbox (format("You slandered my candies and my honesty, so I don't want to do more business with you.
			\pThat includes refunds!"))
			goto (endofroute102scammer)
		}
		
		}

		endofroute102scammer:
		release	
	}