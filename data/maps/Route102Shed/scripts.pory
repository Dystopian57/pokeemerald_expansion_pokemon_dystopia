raw `
Route102Shed_MapScripts::
	.byte 0

`

script Route103ScientistShedTalk {
	    lock
	    setflag (FLAG_SAFE_FOLLOWER_MOVEMENT)

        playse (SE_PIN)

        applymovement (OBJ_EVENT_ID_NPC_FOLLOWER, moves(face_player, emote_exclamation_mark))
        waitmovement (OBJ_EVENT_ID_NPC_FOLLOWER)
        msgbox(format("Most intriguing..."))

        applymovement (OBJ_EVENT_ID_NPC_FOLLOWER, moves(walk_in_place_right))
        waitmovement (OBJ_EVENT_ID_NPC_FOLLOWER)
        applymovement (OBJ_EVENT_ID_NPC_FOLLOWER, moves(walk_in_place_left))
        waitmovement (OBJ_EVENT_ID_NPC_FOLLOWER)
        applymovement (OBJ_EVENT_ID_NPC_FOLLOWER, moves(walk_in_place_down))
        waitmovement (OBJ_EVENT_ID_NPC_FOLLOWER)

        msgbox(format("This must be the supply shed the builders of {COLOR GREEN}Road 002{COLOR DARK_GRAY} were using."))
        applymovement (OBJ_EVENT_ID_NPC_FOLLOWER, moves(walk_in_place_up))
        applymovement (OBJ_EVENT_ID_PLAYER, moves(walk_in_place_down))
        msgbox(format("I see a bizarre cavity on the northern wall of the shed. Let us explore further."))
        setvar(VAR_102_SCIENTIST, 3)
		release
		}


script Route102ShedTrashItem {
	lock
    if (!flag(FLAG_ITEM_102SHED))
	{
    msgbox(format("There's a potted plant inside the trash can..."))
    givedecoration (DECOR_RED_PLANT)
	setflag (FLAG_ITEM_102SHED)	}

    else {
    msgbox(format("The trash can is empty."))
    }

	release
}


script Route102ShedFirstAidKit {
	lock
    if (!flag(FLAG_ITEM_102SHED1STAID))
	{
    msgbox(format("There may be something in the first aid kit..."))
    giveitem (ITEM_SUPER_POTION)
	setflag (FLAG_ITEM_102SHED1STAID)	}

    else {
    msgbox(format("The first aid kit is empty."))
    }

	release
}



script Route102ShedPlant {
	lock
    msgbox(format("Seems the plant withered a long time ago."))
	release
}

script Route102ShedVines {
	lock
    msgbox(format("Vines are creeped from the other side of the wall."))
	release
}

script Route102ShedToolshelf {
	lock
    msgbox(format("The discarded tools have begun to gather rust."))
	release
}

script Route102ShedLadder {
	lock
    msgbox(format("A rather moldy wooden ladder."))
	release
}


script KantonianWarHistoryVol4102Shed {
    lock
    msgbox(format("A book's cover reads “History of the
    Kantonian War, Volume 3”. \p Read it?"))
    dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "Yes", "No")

	if (var(VAR_RESULT) == 0) {

    msgbox(format("June 2009: Slowly but surely, the Rocket-ran Silph Co. begins to extend its tendrils
    into the neighbouring Jotho region.\pThe biggest initial step is the acquisition of Goldenrod's Radio
    Tower.\pGiovanni uses this media investment to wash the company's international image.
    \pIn September of that year he appoints a young trainer called Silver as vice-president."))
	
	}

	if (var(VAR_RESULT) == 1) {release}

	release
}