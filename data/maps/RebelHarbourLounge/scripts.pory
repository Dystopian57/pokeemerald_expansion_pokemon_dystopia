	script PetalburgHarbourTable2DaugtherGuest {
		lock
		applymovement (19, moves(face_player))

		if (!flag(harborloungequestdone))

		{
			msgbox(format("{COLOR LIGHT_GRAY}{SHADOW WHITE}Psst...!{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}
			\p Don't tell daddy, but I'm eating slowly
			so we can be together longer."))
		}

		if (flag(harborloungequestdone))

		{
			msgbox(format("When I'm a good girl, my daddy brings me here to have breakfast!
			\pBut then he says he's not hungry, and I eat most of it.
			\pI think he's just picky!"))
			

		if (!flag(harborloungequestaccepted))

			{
				msgbox(format("When I'm a good girl, my daddy brings me here to have breakfast!
				\pBut then he says he's not hungry, and I eat most of it.
				\pI think he's just picky!"))
			}

			if (flag(harborloungequestaccepted))

			{

				if (flag(tabletwosecondcorrectbreakfast))
				{checkplayergender
				if(var(VAR_RESULT) == MALE){
				msgbox(format("Sir, when is my Shuckle Juice coming? Are they
				asking the Shuckle for it now?"))
				}
				if(var(VAR_RESULT) == FEMALE){
				msgbox(format("Miss, when is my Shuckle Juice coming? Are they
				asking the Shuckle for it now?"))
				}
				}

				if (!flag(tabletwosecondcorrectbreakfast))

				{msgbox(format("Daddy said I can have some Shuckle Juice with my egg! Can I?
				\pDo you ask the Shuckle nicely to give it to you?"))

					dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE,
					"Yes",
					"No")

				if (var(VAR_RESULT) == 0) {
				msgbox(format("That's so cool! Maybe I'll ask my dad for a Shuckle for my birthday."))
				}

				if (var(VAR_RESULT) == 1) {
				msgbox(format("Oh no, please don't be mean to the Shuckle! Don't steal its juice!"))		
				}

				setflag (tabletwosecondcorrectbreakfast)}

				applymovement (19, moves(face_down))
				waitmovement (19)
				goto (PetalburgHarbourOrderChecker)
			
			}
		
		}
		release
		}


