	script PetalburgHarbourOrderChecker {

				if (!flag(harborbreakfastone)
				|| !flag(harborlunchone)
				|| !flag(harbordinnerone))
				
				{

					if((flag(tableonefirstcorrectbreakfast) && 
						flag(tabletwofirstcorrectbreakfast) &&
						flag(tabletwosecondcorrectbreakfast) &&
						flag(tablethreefirstcorrectbreakfast) &&
						flag(tablethreesecondcorrectbreakfast)))

						{

							if (flag(harborbreakfasttakeaway)
							&& flag(harborlunchtakeaway)
							&& flag(harbordinnertakeaway))
							
							{setvar (VAR_WAITERQUEST, 1)}


							if (!flag(harborbreakfasttakeaway)
							|| !flag(harborlunchtakeaway)
							|| !flag(harbordinnertakeaway)
							&& flag(takeawaytookorder))

							
							{setvar (VAR_WAITERQUEST, 1)}		

						}

				}

				if (!flag(harborbreakfasttwo)
				|| !flag(harborlunchtwo)
				|| !flag(harbordinnertwo))
				{

					if((flag(tableonesecondcorrectbreakfast) && 
						flag(tabletwothirdcorrectbreakfast) &&
						flag(tabletwofourthcorrectbreakfast) &&
						flag(tablethreethirdcorrectbreakfast) &&
						flag(tablethreefourthcorrectbreakfast)))

						{

							if (flag(harborbreakfasttakeaway)
							&& flag(harborlunchtakeaway)
							&& flag(harbordinnertakeaway))
							
							{setvar (VAR_WAITERQUEST, 1)}


							if (!flag(harborbreakfasttakeaway)
							|| !flag(harborlunchtakeaway)
							|| !flag(harbordinnertakeaway)
							&& flag(takeawaytookorder))

							
							{setvar (VAR_WAITERQUEST, 1)}		

						}
				}

			

		release
	}


	//TAKEAWAY
	
	//BREAKFAST

		script PetalburgHarbourTakeAwayBreakfastBalsam {
		lock
		applymovement (32, moves(face_player))
		if (!flag(takeawaytookorder))
		{

			setspeaker ([SP_NAME_BALSAM])
			createfieldmugshot (MUGSHOT_BALSAM , EMOTE_NORMAL)
			msgbox(format("{PLAYER}...? Fancy meeting you here. Wait, you work here?"))	

			setspeaker ([SP_NAME_BALSAM])
			createfieldmugshot (MUGSHOT_BALSAM , EMOTE_HAPPY)
			msgbox(format("That's great. I'm happy to see you're readapting to society so quickly."))

			setspeaker ([SP_NAME_BALSAM])
			createfieldmugshot (MUGSHOT_BALSAM , EMOTE_NORMAL)
			msgbox(format("We'll have some Swinub Bacon to take. It'll be a long day of research
			ahead for us, so we need some protein-rich breakfast."))

			setflag (takeawaytookorder)

		}

		else {
			setspeaker ([SP_NAME_BALSAM])
			createfieldmugshot (MUGSHOT_BALSAM , EMOTE_NORMAL)
			msgbox(format("Sorry for giving you extra work - seems like a busy morning here.
			\pTry to get us that Swinub Bacon, and we'll be off."))		
		}
		removefieldmugshot
		goto (PetalburgHarbourOrderChecker)
		release

		}


		script PetalburgHarbourTakeAwayBreakfastAide {
		lock
		applymovement (33, moves(face_player))
		if (!flag(takeawaytookorder))
		{

			setspeaker ([SP_NAME_AIDEE])
			createfieldmugshot (MUGSHOT_AIDEE , EMOTE_HAPPY)
			msgbox(format("{PLAYER}! The Rebel Zone is a small world, isn't it?"))	

			setspeaker ([SP_NAME_AIDEE])
			createfieldmugshot (MUGSHOT_AIDEE , EMOTE_NORMAL)
			msgbox(format("I see you have your own work now, but I hope you can still help
			us with ours."))

				setspeaker ([SP_NAME_AIDEE])
				createfieldmugshot (MUGSHOT_AIDEE , EMOTE_TALK)
				if(var(VAR_LITTLEROOT_PHASE) < 6)
				{
				msgbox(format("... in particular, that Voltorb Shard we asked you to find some time ago."))
				}	

				if(var(VAR_LITTLEROOT_PHASE) > 6)
				{
				msgbox(format("You know what I mean. I'm always expecting your contributions!"))
				}	

			setspeaker ([SP_NAME_AIDEE])
			createfieldmugshot (MUGSHOT_AIDEE , EMOTE_HAPPY)
			msgbox(format("But let's leave that chat for a more private place. Balsam will take our order -
			I've never been too picky."))		

		}

		else {

			setspeaker ([SP_NAME_AIDEE])
			createfieldmugshot (MUGSHOT_AIDEE , EMOTE_HAPPY)
			msgbox(format("Oh, if you want to get back to Littleroot quickly..."))		

			setspeaker ([SP_NAME_AIDEE])
			createfieldmugshot (MUGSHOT_AIDEE , EMOTE_TALK)
			msgbox(format("There's a tunnel shortcut you can take in Petalburg Beach."))	

				if(var(VAR_LITTLEROOT_PHASE) < 6)
				{
				setspeaker ([SP_NAME_AIDEE])
				createfieldmugshot (MUGSHOT_AIDEE , EMOTE_TALK)
				msgbox(format("If you give us a hand with that favour we asked you, I'd be happy to
				tell you more about it."))
				}	

				if(var(VAR_LITTLEROOT_PHASE) > 6)
				{
				setspeaker ([SP_NAME_AIDEE])
				createfieldmugshot (MUGSHOT_AIDEE , EMOTE_TALK)
				msgbox(format("We had that built with a herd of Digletts the Kanto Rebels sent us."))

				setspeaker ([SP_NAME_AIDEE])
				createfieldmugshot (MUGSHOT_AIDEE , EMOTE_NORMAL)
				msgbox(format("It should be useful if a certain company comes knocking on our door..."))

				setspeaker ([SP_NAME_AIDEE])
				createfieldmugshot (MUGSHOT_AIDEE , EMOTE_HAPPY)
				msgbox(format("But I hope we never need to find out!"))
				}	

				if(var(VAR_LITTLEROOT_PHASE) > 7)
				{
				msgbox(format("We had that built with a herd of Digletts the Kanto Rebels sent us."))
				
				setspeaker ([SP_NAME_AIDEE])
				createfieldmugshot (MUGSHOT_AIDEE , EMOTE_NORMAL)
				msgbox(format("If a certain company comes knocking again, we may need to use it..."))

				setspeaker ([SP_NAME_AIDEE])
				createfieldmugshot (MUGSHOT_AIDEE , EMOTE_HAPPY)
				msgbox(format("Unless we can count on you to deal with them again!"))
				}	

		}
		removefieldmugshot		
		goto (PetalburgHarbourOrderChecker)
		release

		}

	//LUNCH


		script PetalburgHarbourTakeAwayLunchNorman {
		lock
		applymovement (47, moves(face_player))
		if (!flag(takeawaytookorder))
		{
			setspeaker ([SP_NAME_NORMAN])
			createfieldmugshot (MUGSHOT_NORMAN , EMOTE_NORMAL)
			msgbox(format("{PLAYER}... I thought that was you. So you're part-timing here?"))	


			setspeaker ([SP_NAME_NORMAN])
			createfieldmugshot (MUGSHOT_NORMAN , EMOTE_HAPPY)
			msgbox(format("You're a hard worker. I guess that comes in the family."))

			setspeaker ([SP_NAME_NORMAN])
			createfieldmugshot (MUGSHOT_NORMAN , EMOTE_TALK)
			msgbox(format("But if you are ever too short on money... I want you to let me help. Will you?"))

					dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE,
					"Yes",
					"No")

					if (var(VAR_RESULT) == 0) {
					setspeaker ([SP_NAME_NORMAN])
					createfieldmugshot (MUGSHOT_NORMAN , EMOTE_ANGRY)
					msgbox(format("Thank you. I know it does not compensate for... anything, really."))

					setspeaker ([SP_NAME_NORMAN])
					createfieldmugshot (MUGSHOT_NORMAN , EMOTE_NORMAL)
					msgbox(format("But I'd be happy to help you in that regard.
					I have a bit saved up from my gym leader days. It's the least I can do."))
					}

					if (var(VAR_RESULT) == 1) {
					setspeaker ([SP_NAME_NORMAN])
					createfieldmugshot (MUGSHOT_NORMAN , EMOTE_ANGRY)
					msgbox(format("I see... of course you won't. And I have no right to complain."))

					setspeaker ([SP_NAME_NORMAN])
					createfieldmugshot (MUGSHOT_NORMAN , EMOTE_NORMAL)
					msgbox(format("But if you ever change your mind, my offer will always stand."))
					}

			setspeaker ([SP_NAME_NORMAN])
			createfieldmugshot (MUGSHOT_NORMAN , EMOTE_TALK)
			msgbox(format("As for my order, I'll have some Magikarp Sushi. Please, I am in no hurry."))

			setflag (takeawaytookorder)

		}

		else {
			setspeaker ([SP_NAME_NORMAN])
			createfieldmugshot (MUGSHOT_NORMAN , EMOTE_TALK)
			msgbox(format("If you find yourself in financial need - please, consider my offer."))

			setspeaker ([SP_NAME_NORMAN])
			createfieldmugshot (MUGSHOT_NORMAN , EMOTE_ANGRY)
			msgbox(format("But I won't insist. Now, how is that Magikarp Sushi coming along?"))
		}
		removefieldmugshot
		goto (PetalburgHarbourOrderChecker)
		release

		}

		//DINNER

		script PetalburgHarbourTakeAwayDinnerSharpy {
		lock
		applymovement (30, moves(face_player))
		if (!flag(takeawaytookorder))
		{

            setspeaker ([SP_NAME_SHARPY])
            createfieldmugshot (MUGSHOT_SHARPY , EMOTE_SHOCK) 
			msgbox(format("Wow, {PLAYER} - you're having dinner here too?"))	

			applymovement (30, moves(face_right))
			applymovement (31, moves(face_right))
			waitmovement (31)

            setspeaker ([SP_NAME_CAMELIA])
            createfieldmugshot (MUGSHOT_CAMELIA , EMOTE_CONFUSED) 
				checkplayergender
				if(var(VAR_RESULT) == MALE){
				msgbox(format("He's working here, silly."))
				}
				if(var(VAR_RESULT) == FEMALE){
				msgbox(format("She's working here, silly."))
				}


            setspeaker ([SP_NAME_CAMELIA])
            createfieldmugshot (MUGSHOT_CAMELIA , EMOTE_NORMAL) 
			applymovement (30, moves(face_player))
			applymovement (31, moves(face_player))
			waitmovement (31)
			msgbox(format("{PLAYER} - can we have a Petalburg Pizza, to take?"))

            setspeaker ([SP_NAME_SHARPY])
            createfieldmugshot (MUGSHOT_SHARPY , EMOTE_POKEBALL) 

			msgbox(format("Oh yeah - with extra cheese! We're sharing it with Norman back
			at the dojo!"))

            setspeaker ([SP_NAME_SHARPY])
            createfieldmugshot (MUGSHOT_SHARPY , EMOTE_SAD) 
			msgbox(format("Oh, I'm sorry... should have told you, and make sure you were free."))

            setspeaker ([SP_NAME_CAMELIA])
            createfieldmugshot (MUGSHOT_CAMELIA , EMOTE_SAD) 
			msgbox(format("Yeah, it was all Sharpy's improv plan..."))

			setspeaker ([SP_NAME_CAMELIA])
			createfieldmugshot (MUGSHOT_CAMELIA , EMOTE_MENACING)
			msgbox(format("That means, we'll invite you next time, and he has to pay!"))

			applymovement (30, moves(face_left))
			waitmovement (30)
            setspeaker ([SP_NAME_SHARPY])
            createfieldmugshot (MUGSHOT_SHARPY , EMOTE_POKEBALL)
			msgbox(format("You're o-..."))

            setspeaker ([SP_NAME_SHARPY])
            createfieldmugshot (MUGSHOT_SHARPY , EMOTE_SHOCK)
			msgbox(format("Wait, why do I have to pay!?"))

			setflag (takeawaytookorder)

		}

		else {
            setspeaker ([SP_NAME_SHARPY])
            createfieldmugshot (MUGSHOT_SHARPY , EMOTE_POKEBALL)	
			msgbox(format("Is the pizza ready yet? Not rushing you guys or anything, but I'm
			peckish!"))
		}
		removefieldmugshot
		goto (PetalburgHarbourOrderChecker)
		release
		
		}


		script PetalburgHarbourTakeAwayDinnerCamelia {
		lock
		applymovement (31, moves(face_player))
		if (!flag(takeawaytookorder))
		{
            setspeaker ([SP_NAME_CAMELIA])
            createfieldmugshot (MUGSHOT_CAMELIA , EMOTE_NORMAL) 
			msgbox(format("So you're working here, {PLAYER}?"))	

			applymovement (31, moves(face_right))
			waitmovement (31)
            setspeaker ([SP_NAME_CAMELIA])
            createfieldmugshot (MUGSHOT_CAMELIA , EMOTE_CONFUSED) 
			msgbox(format("Well, now I feel self-conscious. Sharpy, we should find work too."))	

			applymovement (30, moves(face_left))
			waitmovement (30)
            setspeaker ([SP_NAME_SHARPY])
            createfieldmugshot (MUGSHOT_SHARPY , EMOTE_SHOCK)
			msgbox(format("Y-you're right! We can't depend on Norman forever!"))

            setspeaker ([SP_NAME_SHARPY])
            createfieldmugshot (MUGSHOT_SHARPY , EMOTE_POKEBALL)
			msgbox(format("I've sailed with my dad tons of times, so I could work as
			a sailor in this harbor!"))

			applymovement (31, moves(face_down))
			waitmovement (31)
            setspeaker ([SP_NAME_CAMELIA])
            createfieldmugshot (MUGSHOT_CAMELIA , EMOTE_CONFUSED) 
			msgbox(format("As for me... I'm a good organizer, so perhaps I can work at the
			DLC's library..."))

            setspeaker ([SP_NAME_CAMELIA])
            createfieldmugshot (MUGSHOT_CAMELIA , EMOTE_SAD) 
			msgbox(format("But that means working for Devon. Ugh... anyways..."))

			applymovement (31, moves(face_player))
			waitmovement (31)

            setspeaker ([SP_NAME_CAMELIA])
            createfieldmugshot (MUGSHOT_CAMELIA , EMOTE_NORMAL) 
			msgbox(format("We'll have Slateport Pizza to take, {PLAYER}. Take your time."))

            setspeaker ([SP_NAME_SHARPY])
            createfieldmugshot (MUGSHOT_SHARPY , EMOTE_HAPPY)
			applymovement (30, moves(face_player))
			waitmovement (30)
			msgbox(format("Extra cheese, please!"))

            setspeaker ([SP_NAME_SHARPY])
            createfieldmugshot (MUGSHOT_SHARPY , EMOTE_NORMAL)
			msgbox(format("We'll make sure you're free next time, and eat
			one together at the dojo!"))

			setflag (takeawaytookorder)

		}

		else {
            setspeaker ([SP_NAME_CAMELIA])
            createfieldmugshot (MUGSHOT_CAMELIA , EMOTE_NORMAL) 
			msgbox(format("Don't mind us too much, {PLAYER}. Don't want to interfere with
			your work."))

            setspeaker ([SP_NAME_CAMELIA])
            createfieldmugshot (MUGSHOT_CAMELIA , EMOTE_MENACING) 
			msgbox(format("I'll make sure this ravenous guy here doesn't assault your kitchen."))

            setspeaker ([SP_NAME_SHARPY])
            createfieldmugshot (MUGSHOT_SHARPY , EMOTE_POKEBALL)
			applymovement (30, moves(face_left))
			waitmovement (30)
			msgbox(format("Hey, you're the one whose stomach is rumbling here!"))

			applymovement (31, moves(face_right))
			waitmovement (31)
            setspeaker ([SP_NAME_CAMELIA])
            createfieldmugshot (MUGSHOT_CAMELIA , EMOTE_ANGRY) 
			msgbox(format("S-shut up!"))

		}
		removefieldmugshot		
		goto (PetalburgHarbourOrderChecker)
		release
		
		}

