						{
						playse (SE_M_METRONOME)
						applymovement(49, moves(emote_double_exclamation_mark))
						waitmovement (49)

						playse (SE_M_METRONOME)
						applymovement(50, moves(emote_double_exclamation_mark))
						waitmovement (50)
