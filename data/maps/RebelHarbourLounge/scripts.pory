							special (SpawnCameraObject)
							applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_up * 4))
							waitmovement(OBJ_EVENT_ID_CAMERA)
							special (RemoveCameraObject)


					applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
					applymovement (OBJ_EVENT_ID_FOLLOWER, moves(face_up))
					waitmovement (OBJ_EVENT_ID_FOLLOWER)



						if (var(VAR_WAITERQUEST) == 1) //none correct
						{
						msgbox(format("... you did not get a single order right. That's kind of
						impressive."))
						showmoneybox (18, 0)
						msgbox(format("What's not impressive is your pay - 500¥."))
						
						addmoney (500)
						updatemoneybox
						playse (SE_RG_SHOP)
						waitse
						hidemoneybox

						msgbox(format("And be thankful it doesn't
						come with a Megakick as a tip."))	
						}

						if (var(VAR_WAITERQUEST) == 2) //1 correct
						{
						msgbox(format("You got a single correct order right. Wonder if it
						was pure luck..."))

						showmoneybox (18, 0)		

						msgbox(format("Speaking of luck, you're lucky I'm even paying you
						these 1000¥."))

						addmoney (1000)
						updatemoneybox
						playse (SE_RG_SHOP)
						waitse
						hidemoneybox

						msgbox(format("Now get out of my sight."))			
						}

						if (var(VAR_WAITERQUEST) == 3) //2 correct
						{
						msgbox(format("You got only a couple orders right. Were you even paying
						attention?"))	
						showmoneybox (18, 0)
						msgbox(format("Well, here's all I can give you for your lousy work -  1500¥."))								

						addmoney (1500)
						updatemoneybox
						playse (SE_RG_SHOP)
						waitse
						hidemoneybox

						msgbox(format("If you think you can do better, you can come help again.
						See ya."))	
						
						}

						if (var(VAR_WAITERQUEST) == 4) //3 correct
						{
						msgbox(format("You got two orders wrong... well. It's not like people
						expect much better in this joint."))
						showmoneybox (18, 0)
						msgbox(format("Still, I need to deduct 1000¥ from your pay. I don't
						make the rules."))
						addmoney (2000)
						updatemoneybox
						playse (SE_RG_SHOP)
						waitse
						hidemoneybox

						msgbox(format("Could use you tomorrow too. Evenings aside, we're
						busy all the time."))

						}

						if (var(VAR_WAITERQUEST) == 5) //4 correct
						{
						showmoneybox (18, 0)
						msgbox(format("You got one order wrong, but that's better than our
						average part-timer."))		
						addmoney (2500)
						updatemoneybox
						playse (SE_RG_SHOP)
						waitse
						hidemoneybox

						msgbox(format("Good job today. If you need some quick cash again,
						come right back."))

						}

						if (var(VAR_WAITERQUEST) == 6) //5 correct
						{
						msgbox(format("Wow, you got every order right. I'm impressed."))					
						}

						closemessage

						clearflag (harborloungequestaccepted)
						clearflag (morningstartwaiterquest)
						clearflag (daystartwaiterquest)
						clearflag (nightstartwaiterquest)


						setvar (VAR_WAITERQUEST, 0)
						setvar (VAR_WAITERFIRSTTABLESUCCESS, 0)
						setvar (VAR_WAITERSECONDTABLESUCCESS, 0)
						setvar (VAR_WAITERTHIRDTABLESUCCESS, 0)

						clearflag (tableonefirstcorrectbreakfast)
						clearflag (tableonesecondcorrectbreakfast)

						clearflag (tabletwofirstcorrectbreakfast)
						clearflag (tabletwosecondcorrectbreakfast)
						clearflag (tabletwothirdcorrectbreakfast)
						clearflag (tabletwofourthcorrectbreakfast)

						clearflag (tablethreefirstcorrectbreakfast)
						clearflag (tablethreesecondcorrectbreakfast)
						clearflag (tablethreethirdcorrectbreakfast)
						clearflag (tablethreefourthcorrectbreakfast)

						fadeoutbgm (1)
						fadeinbgm (1)
						playbgm (MUS_PIRATESGUIGE, TRUE)

						goto (rebelharborloungeclerkend)

					}
					
					
					}
				

				rebelharborloungeclerkend:
				release
				

				}





	script PetalburgHarbourOrderChecker {
			if (flag(morningstartwaiterquest))
			{

				if (!flag(harborbreakfastone))
				{

					if((flag(tableonefirstcorrectbreakfast) && 
						flag(tabletwofirstcorrectbreakfast) &&
						flag(tabletwosecondcorrectbreakfast) &&
						flag(tablethreefirstcorrectbreakfast) &&
						flag(tablethreesecondcorrectbreakfast)))

						{
						setvar (VAR_WAITERQUEST, 1)	
						}

				}

				if (!flag(harborbreakfasttwo))
				{

					if((flag(tableonesecondcorrectbreakfast) && 
						flag(tabletwothirdcorrectbreakfast) &&
						flag(tabletwofourthcorrectbreakfast) &&
						flag(tablethreethirdcorrectbreakfast) &&
						flag(tablethreefourthcorrectbreakfast)))

						{
						setvar (VAR_WAITERQUEST, 1)	
						}
				}

			}

		release
	}


	//TABLE 1 GUEST SCRIPTS
	script PetalburgHarbourTable1YoungFatManGuest {
		lock
		applymovement (7, moves(face_player))


		if (flag(harborloungequestdone))

		{
			msgbox(format("I still have room for a bit more..."))	
		}

		if (!flag(harborloungequestdone))

		{

			if (!flag(harborloungequestaccepted))

			{
			msgbox(format("I never get tired of the burgers here, but maybe I'll try something
			new today..."))
			}

			if (flag(harborloungequestaccepted))

			{
			

				if (flag(tableonefirstcorrectbreakfast))

				{msgbox(format("Are you deaf? I said I want a Petalburger! Come on, I'm starving here!"))
				}

				if (!flag(tableonefirstcorrectbreakfast))

				{msgbox(format("Hmm... I'll have a Slateport Pizz-... nay, a Petalburger!"))
				setflag (tableonefirstcorrectbreakfast)
				}
			
			}
			
			}

		applymovement (7, moves(face_left))
		waitmovement (7)
		goto (PetalburgHarbourOrderChecker)
		release
		}

