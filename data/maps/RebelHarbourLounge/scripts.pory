			applymovement (13, moves(jump_in_place_left))
			waitmovement (13)
			
			playmoncry (SPECIES_ZIGZAGOON, CRY_MODE_NORMAL)
			msgbox(format("Za-gggooo!"))

			applymovement (13, moves(face_down))
			waitmovement (13)



		}

		if (!flag(harborloungequestdone))

		{
		
			if (!flag(harborloungequestaccepted))

			{

			msgbox(format("My brother found some pokéyen on the floor, so we're using it to-!"))
			applymovement (22, moves(face_down))	
			applymovement (21, moves(face_up))
			waitmovement (21)
			msgbox(format("Sssh, be quiet! Somene here might have dropped it, and ask it back!"))
			applymovement (21, moves(walk_in_place_up))
			msgbox(format("{COLOR LIGHT_GRAY}{SHADOW WHITE}Oh, I'm sorry big bro...!"))
			applymovement (22, moves(face_left))
			}

			if (flag(harborloungequestaccepted))

			{

				if (flag(tablethreefourthcorrectbreakfast))

				{msgbox(format("Did you know? If you pour water in a can with Swablu Candies...
				\pYou get tasty candy water!"))
				}

				if (!flag(tablethreefourthcorrectbreakfast))

				{msgbox(format("I'll have some Swablu Candies, please!"))

				applymovement (22, moves(face_down))	
				applymovement (21, moves(face_up))
				waitmovement (21)
				msgbox(format("One... if we order the meal, we only have money for one, sis."))
				applymovement (21, moves(walk_in_place_up))
				msgbox(format("Oh, okay... just one then!"))
				applymovement (22, moves(face_left))

				setflag (tablethreefourthcorrectbreakfast)
				}}}

		applymovement (21, moves(face_left))
		waitmovement (21)
		goto (PetalburgHarbourOrderChecker)
		release
		}



