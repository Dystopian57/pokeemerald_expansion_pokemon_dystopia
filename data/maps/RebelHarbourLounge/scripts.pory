mapscripts RebelHarbourLounge_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: RebelHarbourLoungeMapscriptBundle
    MAP_SCRIPT_ON_LOAD: RebelHarbourLoungeMapscriptBundle
    MAP_SCRIPT_ON_FRAME_TABLE: RebelHarbourLoungeMapscriptBundle}
	


script RebelHarbourLoungeMapscriptBundle {

		gettimeofday
		if (var(VAR_0x8000) == TIME_MORNING)
		{setweather (WEATHER_NONE)
		
		//BREAKFAST GUESTS LOTTO

			if (!flag(harborloungebreakfastguestlotto))
			{random (2)
			copyvar (VAR_TEMP_1, VAR_RESULT)
			switch (var(VAR_RESULT))
			{
			case 0: 
			clearflag (harborbreakfastone)

			setflag(harborbreakfasttwo)
			setflag (harborlunchone)
			setflag (harborlunchtwo)
			setflag (harbordinnerone)
			setflag (harbordinnertwo)

			case 1:
			clearflag (harborbreakfasttwo)
			setflag(harborbreakfastone)
			setflag (harborlunchone)
			setflag (harborlunchtwo)
			setflag (harbordinnerone)
			setflag (harbordinnertwo)
			}	

			setflag (harborloungebreakfastguestlotto)
			}

		
		}

		if (var(VAR_0x8000) == TIME_DAY)
		{setweather (WEATHER_NONE)
		
		
		

		
		
		}

		if (var(VAR_0x8000) == TIME_EVENING)
		{setweather (WEATHER_NONE)}

		if (var(VAR_0x8000) == TIME_NIGHT)
		{setweather (WEATHER_SHADE)}




goto (DayNightNPC)
}


script RebelHarborTouristAsksRebento {
	lock
	applymovement (15, moves(face_player))
	waitmovement (15)
	msgbox(format("This is foreign discrimination, plain and simple!
	\pI've heard they sell a Rebel-themed lunch box here, called Rebento!
	\pBut they won't sell it to me - surely because I'm a foreigner!"))
	applymovement (15, moves(face_right))
	waitmovement (15)
	release
}

script RebelHarborGuyCalmsTourist {
	lock
	msgbox(format("SSSSH. You've got it all wrong pal. Believe me, you don't want one of those.
	\pJust get a Petalburguer and sit your fat arse down."))
	release
}


script RebelHarborLoungeClerkOverCounter {
	lock
	applymovement (4, moves(face_player))
	waitmovement (4)
	msgbox(format("Hey, don't invade my space! If you want to order, go over the counter."))
	applymovement (4, moves(face_right))
	waitmovement (4)
	release
}

script RebelHarborLoungeClerk {
	lock

	if(!flag(harborloungequestaccepted))
	{goto (normalharborloungeclerkstart)}

	if(flag(harborloungequestaccepted))
	{goto (questactiveharborloungeclerk)}

	normalharborloungeclerkstart:
	msgbox(format("What do you want?"))


			dynmultichoice(0, 0, TRUE, 4, 0, DYN_MULTICHOICE_CB_NONE,
			"Order food",
			"Special order",
			"Part time job",
			"Leave")

				if (var(VAR_RESULT) == 3) {
				goto (rebelharborloungeclerkend)
				}

				if (var(VAR_RESULT) == 0) {}

				if (var(VAR_RESULT) == 1) {}

				if (var(VAR_RESULT) == 2) {

					if (flag(harborloungequestdone))
					{
					msgbox(format("You already worked here today. We're not hiring full-time, sorry!"))
					goto (rebelharborloungeclerkend)
					}

					if (!flag(harborloungequestdone))
					{

						gettimeofday
						if (var(VAR_0x8000) == TIME_MORNING)
						{
						setflag (morningstartwaiterquest)
						msgbox(format("You come just in time. We could use a couple extra hands to serve
						breakfast."))
						}

						if (var(VAR_0x8000) == TIME_DAY)
						{
						setflag (daystartwaiterquest)
						msgbox(format("You come just in time. We could use a couple extra hands to serve
						lunch."))
						}

						if (var(VAR_0x8000) == TIME_EVENING)
						{
						msgbox(format("We don't need any help on the evenings.\p But come back on the
						morning, midday or night, and we'll likely do."))
						goto (rebelharborloungeclerkend)
						}

						if (var(VAR_0x8000) == TIME_NIGHT)
						{
						setflag (nightstartwaiterquest)
						msgbox(format("You come just in time.
						We could use a couple extra hands to serve dinner."))
						}

						checkplayergender
						if(var(VAR_RESULT) == FEMALE){
						msgbox(format("... well, one hand, in your case."))}
						msgbox(format("3000¥ per shift, with deductions if you mess up. You in?"))

							dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE,
							"Sure",
							"No thanks",)

								if (var(VAR_RESULT) == 1) {
								msgbox(format("Too hard for you?
								They're also hiring on the cargo bay, if that's more your fancy."))
								goto (rebelharborloungeclerkend)				
								}

								if (var(VAR_RESULT) == 0) {
								msgbox(format("Great - go and get those orders then!"))
								closemessage

								
								setflag (harborloungequestaccepted)
								//fadescreenswapbuffers (FADE_TO_BLACK)
	
								//fadescreenswapbuffers (FADE_FROM_BLACK)

								fadeoutbgm (1)
								fadeinbgm (1)
								playbgm (MUS_BUYSOMETHINGWILLYA, TRUE)
        						//warpsilent (MAP_REBEL_HARBOUR_LOUNGE, 4)
								}


					goto (rebelharborloungeclerkend)

						}

					}

						questactiveharborloungeclerk:
						if (var(VAR_WAITERQUEST) == 0) {
	
						harborloungeclerkdemandsorders:
						msgbox(format("What are you waiting for? You haven't picked everyone's orders!"))	
						}
						
						if (var(VAR_WAITERQUEST) == 1) {
						harborloungeclerkrevieworders:
						msgbox(format("Alright, let's go over the orders."))
							special (SpawnCameraObject)
							applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_left * 4))
							waitmovement(OBJ_EVENT_ID_CAMERA)
							special (RemoveCameraObject)
						msgbox(format("What does Table 1 want?"))


					//MORNING
						//TABLE 1
						if (flag(morningstartwaiterquest))
						{	
						dynmultichoice(0, 0, TRUE, 6, 0, DYN_MULTICHOICE_CB_NONE,
						"Barboach Caviar", //0
						"Boiled Shellder", //1
						"Carvanha Fin Soup", //2
						"Corphish Legs", //3
						"Dried Feebas", //4
						"Magikarp Sushi", //5
						"Murkrow Egg", //6
						"Petalburger", //7
						"Octiyaki", //8
						"Slateport Pizza", //9
						"Sautéed Shiitako", //10
						"Seedot Nuts", //11
						"Shaved Aryscream", //12
						"Shuckle Juice", //13
						"Swablu Candy", //14
						"Swinub Bacon", //15
						"Wingull Wings") //16

							if (var(VAR_RESULT) == 7) //Petalburger , ordered by young fat man
							{
								if (flag(tableonefirstcorrectbreakfast))
								{
        						addvar (VAR_WAITERQUEST, + 1)
								addvar (VAR_WAITERFIRSTTABLESUCCESS, + 1)
								}

								else {goto (proceedtotable2)}
							
							}
							if (var(VAR_RESULT) == 15) //Swinub Bacon, ordered by old fat man
							{

								if (flag(tableonesecondcorrectbreakfast))
								{
        						addvar (VAR_WAITERQUEST, + 1)
								addvar (VAR_WAITERFIRSTTABLESUCCESS, + 1)
								}

								else {goto (proceedtotable2)}

							}

							else {goto (proceedtotable2)}

						proceedtotable2:
							special (SpawnCameraObject)
							applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_down * 5, walk_right * 1))
							waitmovement(OBJ_EVENT_ID_CAMERA)
							special (RemoveCameraObject)

					msgbox(format("Alright. What about Table 2?"))

					//MORNING
						//TABLE 2, FIRST ASK
						dynmultichoice(0, 0, TRUE, 6, 0, DYN_MULTICHOICE_CB_NONE,
						"Barboach Caviar", //0
						"Boiled Shellder", //1
						"Carvanha Fin Soup", //2
						"Corphish Legs", //3
						"Dried Feebas", //4
						"Magikarp Sushi", //5
						"Murkrow Egg", //6
						"Petalburger", //7
						"Octiyaki", //8
						"Slateport Pizza", //9
						"Sautéed Shiitako", //10
						"Seedot Nuts", //11
						"Shaved Aryscream", //12
						"Shuckle Juice", //13
						"Swablu Candy", //14
						"Swinub Bacon", //15
						"Wingull Wings") //16


							if (var(VAR_RESULT) == 6) //Murkrow Egg, ordered by Wage Slave
							{
								if (flag(tabletwofirstcorrectbreakfast))
								{
        						addvar (VAR_WAITERQUEST, + 1)
								addvar (VAR_WAITERSECONDTABLESUCCESS, + 1)
								clearflag (tabletwofirstcorrectbreakfast)
								goto (proceedtotable2seconchoice)
								}

								else {goto (proceedtotable2seconchoice)}
									
							}


							if (var(VAR_RESULT) == 13) //Shuckle Juice, ordered by Wage Slave's daughter
							{

								if (flag(tabletwosecondcorrectbreakfast))
