	script PetalburgHarbourKitchenHelperBlocking {
		lock
		applymovement (42, moves(face_player))

		if (var(VAR_PETALBURG_PHASE) < 2)
		{
			msgbox(format("We've got uhm, a small issue in the kitchen. Can't let you
			in right now."))
		}

		if (var(VAR_PETALBURG_PHASE) > 2)
		{
			msgbox(format("We've got uhm, a small issue in the kitchen. Can't let you
			in right now."))
		}


		release	
		}

	script PetalburgHarbourKitchenHelperCleaning {
		lock


		if (var(VAR_PETALBURG_PHASE) < 2)
		{
			msgbox(format("We've got uhm, a small issue in the kitchen. Can't let you
			in right now."))
		}

		if (var(VAR_PETALBURG_PHASE) > 2)
		{

			playse (SE_M_BUBBLE)
			waitse
			playse (SE_M_BUBBLE)
			waitse
			applymovement (43, moves(face_player))
			msgbox(format("... what, you get a kick off seeing people work? Get out of my space."))
		}


		applymovement (43, moves(face_up))

		release	
		}

