						}

						if (var(VAR_WAITERTHIRDTABLESUCCESS) == 2)
						{
						if (!flag(harborbreakfastone))
						{
						playse (SE_M_ATTRACT)
						applymovement(36, moves(emote_double_exclamation_mark))
						waitmovement (36)

						playse (SE_M_ATTRACT)
