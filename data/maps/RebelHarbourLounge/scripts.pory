	script PetalburgHarbourTable2DaugtherGuest {
		lock
		applymovement (19, moves(face_player))

		if (flag(harborloungequestdone))

		{
			msgbox(format("{COLOR LIGHT_GRAY}{SHADOW WHITE}Psst...!{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}
			\p Don't tell daddy, but I'm eating slowly
			so we can be together longer."))
		}

		if (!flag(harborloungequestdone))

		{
			

		if (!flag(harborloungequestaccepted))

			{
				msgbox(format("When I'm a good girl, my daddy brings me here to have breakfast!
				\pBut then he says he's not hungry, and I eat most of it.
				\pI think he's just picky!"))
			}

			if (flag(harborloungequestaccepted))

			{

				if (flag(tabletwosecondcorrectbreakfast))
				{checkplayergender
				if(var(VAR_RESULT) == MALE){
				msgbox(format("Sir, when is my Shuckle Juice coming? Are they
