								else {goto (proceedtotable3)}

							}


							if (var(VAR_RESULT) == 5) //Dried Feebas, ordered by Mercenary M
							{
								if (flag(tabletwothirdcorrectbreakfast))
								{
        						addvar (VAR_WAITERQUEST, + 1)
								addvar (VAR_WAITERSECONDTABLESUCCESS, + 1)
								clearflag (tabletwothirdcorrectbreakfast)
								goto (proceedtotable3)
								}

								else {goto (proceedtotable3)}
									
							}

							if (var(VAR_RESULT) == 17) //Wingull Wings, for Mercenary M's Raticate
							{
								if (flag(tabletwofourthcorrectbreakfast))
								{
        						addvar (VAR_WAITERQUEST, + 1)
								addvar (VAR_WAITERSECONDTABLESUCCESS, + 1)
								clearflag (tabletwofourthcorrectbreakfast)
								goto (proceedtotable3)
								}

								else {goto (proceedtotable3)}
									
							}

							else {goto (proceedtotable3)}


						proceedtotable3:
							special (SpawnCameraObject)
							applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_right * 6))
							waitmovement(OBJ_EVENT_ID_CAMERA)
							special (RemoveCameraObject)

					msgbox(format("Alright. To finish up, tell me what Table 3 has ordered."))

					//MORNING
						//TABLE 3
						dynmultichoice(0, 0, TRUE, 6, 0, DYN_MULTICHOICE_CB_NONE,
						"Barboach Caviar", //0
						"Boiled Shellder", //1
						"Carvanha Fin Soup", //2
						"Corphish Legs", //3
						"Dried Feebas", //4
						"Magikarp Sushi", //5
						"Murkrow Egg", //6
						"Petalburger", //7
						"Octiyaki", //8
						"Slateport Pizza", //9
						"Sautéed Shiitako", //10
						"Seedot Nuts", //11
						"Shaved Aryscream", //12
						"Shuckle Juice", //13
						"Swablu Candy", //14
						"Swinub Bacon", //15
						"Wingull Wings") //16

							if (var(VAR_RESULT) == 4) //Dried Feebas, ordered by Bandaged Man
							{
								if (flag(tablethreefirstcorrectbreakfast))
								{
        						addvar (VAR_WAITERQUEST, + 1)
								addvar (VAR_WAITERTHIRDTABLESUCCESS, + 1)
								clearflag (tablethreefirstcorrectbreakfast)
								goto (proceedtotable3seconchoice)
								}

								else {goto (proceedtotable3seconchoice)}
							
							}

							if (var(VAR_RESULT) == 10) //Sautéed Shiitako, ordered by Trapinch Tecnician
							{
								if (flag(tablethreesecondcorrectbreakfast))
								{
        						addvar (VAR_WAITERQUEST, + 1)
								addvar (VAR_WAITERTHIRDTABLESUCCESS, + 1)
								clearflag (tablethreesecondcorrectbreakfast)
								goto (proceedtotable3seconchoice)
								}

								else {goto (proceedtotable3seconchoice)}
							
							}

							if (var(VAR_RESULT) == 2) //Carvanha Fin Soup, for Poor Woman
							{
								if (flag(tablethreethirdcorrectbreakfast))
								{
        						addvar (VAR_WAITERQUEST, + 1)
								addvar (VAR_WAITERTHIRDTABLESUCCESS, + 1)
								clearflag (tablethreethirdcorrectbreakfast)
								goto (proceedtotable3seconchoice)
								}

								else {goto (proceedtotable3seconchoice)}
							
							}

							if (var(VAR_RESULT) == 11) //Seedot Nuts, for Poor Woman's Cubone
							{
								if (flag(tablethreefourthcorrectbreakfast))
								{
        						addvar (VAR_WAITERQUEST, + 1)
								addvar (VAR_WAITERTHIRDTABLESUCCESS, + 1)
								clearflag (tablethreefourthcorrectbreakfast)
								goto (proceedtotable3seconchoice)
								}

								else {goto (proceedtotable3seconchoice)}
							
							}


							else {goto (proceedtotable3seconchoice)}



					proceedtotable3seconchoice:
					msgbox(format("Anything else on Table 3?"))

					//MORNING
						//TABLE 3, SECOND ASK
						dynmultichoice(0, 0, TRUE, 6, 0, DYN_MULTICHOICE_CB_NONE,
						"No, nothing", //0
						"Barboach Caviar", //1
						"Boiled Shellder", //2
						"Carvanha Fin Soup", //3
						"Corphish Legs", //4
						"Dried Feebas", //5
						"Magikarp Sushi", //6
						"Murkrow Egg", //7
						"Petalburger", //8
						"Octiyaki", //9
						"Slateport Pizza", //10
						"Sautéed Shiitako", //11
						"Seedot Nuts", //12
						"Shaved Aryscream", //13
						"Shuckle Juice", //14
						"Swablu Candy", //15
						"Swinub Ham", //16
						"Wingull Wings") //17

							if (var(VAR_RESULT) == 5) //Dried Feebas, ordered by Bandaged Man
							{
								if (flag(tablethreefirstcorrectbreakfast))
								{
        						addvar (VAR_WAITERQUEST, + 1)
								addvar (VAR_WAITERTHIRDTABLESUCCESS, + 1)
								clearflag (tablethreefirstcorrectbreakfast)
								goto (finishedwaiterorderrelay)
								}

								else {goto (finishedwaiterorderrelay)}
							
							}

							if (var(VAR_RESULT) == 11) //Sautéed Shiitako, ordered by Trapinch Tecnician
							{
								if (flag(tablethreesecondcorrectbreakfast))
								{
        						addvar (VAR_WAITERQUEST, + 1)
								addvar (VAR_WAITERTHIRDTABLESUCCESS, + 1)
								clearflag (tablethreesecondcorrectbreakfast)
								goto (finishedwaiterorderrelay)
								}

								else {goto (finishedwaiterorderrelay)}
							
							}

							if (var(VAR_RESULT) == 3) //Carvanha Fin Soup, for Poor Woman
							{
								if (flag(tablethreethirdcorrectbreakfast))
								{
        						addvar (VAR_WAITERQUEST, + 1)
								addvar (VAR_WAITERTHIRDTABLESUCCESS, + 1)
								clearflag (tablethreethirdcorrectbreakfast)
								goto (finishedwaiterorderrelay)
								}

								else {goto (finishedwaiterorderrelay)}
							
							}

							if (var(VAR_RESULT) == 12) //Seedot Nuts, for Poor Woman's Cubone
							{
								if (flag(tablethreefourthcorrectbreakfast))
								{
        						addvar (VAR_WAITERQUEST, + 1)
								addvar (VAR_WAITERTHIRDTABLESUCCESS, + 1)
								clearflag (tablethreefourthcorrectbreakfast)
								goto (finishedwaiterorderrelay)
								}

								else {goto (finishedwaiterorderrelay)}
							
							}

							else {goto (finishedwaiterorderrelay)}


							finishedwaiterorderrelay:
							special (SpawnCameraObject)
							applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_left * 3, walk_up * 5))
							waitmovement(OBJ_EVENT_ID_CAMERA)
							special (RemoveCameraObject)


					msgbox(format("Very well. I'll take this to the cook. Standby to deliver
					the orders!"))

					fadescreenswapbuffers (FADE_TO_BLACK)

					clearflag (breakfastonefoodtrays)
					addobject (41)
					addobject (38)
					addobject (37)
					addobject (39)
					addobject (40)


						if (flag(harborbreakfastone))
						{
						setobjectxy (41, 3, 8)
						setobjectxy (38, 4, 12)
						setobjectxy (37, 5, 12)
						setobjectxy (39, 10, 14)
						setobjectxy (40, 11, 14)
						}

						if (flag(harborbreakfasttwo))
						{
						setobjectxy (41, 3, 9)
						setobjectxy (38, 4, 12)
						setobjectxy (37, 4, 12)
						setobjectxy (39, 10, 14)
						setobjectxy (40, 10, 14)
						}	


					fadeoutbgm (1)
					fadeinbgm (1)
					playbgm (MUS_CONTEST_RESULTS, TRUE)

					applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
					
					hidefollower
					//applymovement (OBJ_EVENT_ID_FOLLOWER, moves(face_down))
					//waitmovement (OBJ_EVENT_ID_FOLLOWER)

					fadescreenswapbuffers (FADE_FROM_BLACK)

					msgbox(format("{COLOR GREEN}{PLAYER} has delivered the orders, and observes the
					guests' reaction..."))
					closemessage

						special (SpawnCameraObject)
						applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_down * 4))
						waitmovement(OBJ_EVENT_ID_CAMERA)
						special (RemoveCameraObject)		

					//BREAKFAST SCORE
					//BREAKFAST TABLE 1 SCORE EMOTES (EITHER DOUBLE EXCLAMATION OR HEART)

						if (var(VAR_WAITERFIRSTTABLESUCCESS) == 0)
						{

						if (flag(harborbreakfastone))
						{
						playse (SE_M_SWAGGER2)
						applymovement(7, moves(emote_double_exclamation_mark))
						waitmovement (7)
						}

						if (flag(harborbreakfasttwo))
						{
						playse (SE_M_SWAGGER2)
						applymovement(29, moves(emote_double_exclamation_mark))
						waitmovement (29)
						}	

						msgbox(format("Table 1 does not seem very happy."))

						}

						if (var(VAR_WAITERFIRSTTABLESUCCESS) == 1)
						{
						if (flag(harborbreakfastone))
						{
						playse (SE_M_ATTRACT)
						applymovement(7, moves(emote_double_exclamation_mark))
						waitmovement (7)
						}

						if (flag(harborbreakfasttwo))
						{
						playse (SE_M_ATTRACT)
						applymovement(29, moves(emote_double_exclamation_mark))
						waitmovement (29)
						}	

						msgbox(format("Table 1 seems quite happy."))

						}


					//BREAKFAST TABLE 2 SCORE EMOTES

						if (var(VAR_WAITERSECONDTABLESUCCESS) == 0)
						{

						if (!flag(harborbreakfastone))
						{
						playse (SE_M_SWAGGER2)
						applymovement(18, moves(emote_double_exclamation_mark))
						waitmovement (18)

						playse (SE_M_SWAGGER2)
						applymovement(19, moves(emote_double_exclamation_mark))
						waitmovement (19)
						}	

