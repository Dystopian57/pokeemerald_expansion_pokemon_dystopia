raw `


`

mapscripts OldaleTown_House2_2F_MapScripts {
    MAP_SCRIPT_ON_LOAD: DayNightAmbientLight
    MAP_SCRIPT_ON_TRANSITION: DayNightAmbientLight
    MAP_SCRIPT_ON_FRAME_TABLE: DayNightAmbientLight}


script OldaleTownHouse2Annebrother {
	lockall
	applymovement (2, moves(face_player))
	setflag (FLAG_SAFE_FOLLOWER_MOVEMENT)
	if(var(VAR_JOELQUESTS) == 0)
    {msgbox(format("Go, Purachu - use Thundershock! BZZZTBZ! \p
	{COLOR LIGHT_GRAY}{SHADOW WHITE}The kid flashes a Purachu Card in front of you.{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}
	\p Hehe... mom says I shouldn't play with Pokémon, or even Safemon. \p So I play with cards instead!"))}

	if(var(VAR_JOELQUESTS) == 1)
    {msgbox(format("Go, Purachu - use Thundershock! BZZZTBZ! \p
	{COLOR LIGHT_GRAY}{SHADOW WHITE}The kid flashes a Purachu Card in front of you.{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}
	Hehe... mom says I shouldn't play with Pokémon, or even Safemon. So I play with cards instead!"))}

	if(var(VAR_JOELQUESTS) == 2)
    {
    msgbox(format("I just heard mom and sis arguing again... I hope we move to {COLOR BLUE}New Rustboro{COLOR DARK_GRAY} soon.
	\p Dad says he'll earn tons of money with his new job, and that we won't argue again then!"))}

	if(var(VAR_JOELQUESTS) == 3)
    {
    msgbox(format("Hooray, sis is back! We're off to the city!"))}
	//foreshadowing... they don't argue again because money separates them
	applymovement (2, moves(face_down))
	waitmovement (2)
	releaseall
}

script AnnesHouseBrotherItem {
	lock
    finditem (ITEM_FULL_INCENSE)
    removeobject (3)
	releaseall}

script AnnesHouseDrawerItem {
	lock
	if (!flag (FLAG_ITEM_OLDALE_HOUSE2DRAWER))
	{msgbox(format("There's something left behind in the drawer..."))
    finditem (ITEM_METRONOME)
	setflag (FLAG_ITEM_OLDALE_HOUSE2DRAWER)
	releaseall}

	else {
	msgbox(format("There's nothing in the drawer."))
	release
	}
}

script AnneHouseTrashBin2F {
	lock
	if (!flag (FLAG_ITEM_OLDALE_HOUSE2BIN))
	{msgbox (format("There's a discarded cable in the trash can..."))
	giveitem (ITEM_LINKING_CORD)
	setflag (FLAG_ITEM_OLDALE_HOUSE2BIN)}
	else
	{msgbox (format("The trash can is empty."))}
	releaseall	
}

script OldaleTownHouse2Bed {
	lockall
    msgbox(format("Looks comfy to sleep in, but it's someone else's..."))
	releaseall
}

script OldaleTownHouse2MineralCollection {
	lockall
    msgbox(format("A mineral collection. It's not too impressive."))
	releaseall
}

script OldaleTownHouse2BigPainting {
	lockall
    msgbox(format("A beautiful city sunset. The painting title is “{COLOR BLUE}New Rustboro{COLOR DARK_GRAY} Bay”."))
	releaseall
}

script OldaleTownHouse2SmallPainting {
	lockall
    msgbox(format("A river crossing a wide, green plan. Haven't seen one of these in a while."))
	releaseall
}