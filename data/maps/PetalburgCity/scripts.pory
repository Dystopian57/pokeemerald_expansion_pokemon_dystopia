	script PetalburgMartialArtsSenseiNight
	{
	lock

	if (var(VAR_SENSEIQTRAININGQUEST) == 0) {
	applymovement (60, moves(face_player))
    msgbox(format("Hm? If you come for the training session, it's over now.
	\pCome back tomorrow, during the day."))
	applymovement (60, moves(face_up))
	}

	if (var(VAR_SENSEIQTRAININGQUEST) == 1) {
	applymovement (60, moves(face_player))
    msgbox(format("You should go to sleep. Resting is important to keep your strength up."))
	applymovement (60, moves(face_up))
	}

	waitmovement (60)

	release

	}

script PetalburgMartialArtsSensei {

	lock

	if (var(VAR_SENSEIQTRAININGQUEST) == 1) {

    msgbox(format("Remember. Martial arts are supposed to quell conflict, not fuel it.
	\pThose who use power wrongly... they risk being destroyed by it."))
	goto (senseiscriptend)
	}

	if (var(VAR_SENSEIQTRAININGQUEST) == 0) {

    msgbox(format("That's it - control your breathing! Watch your forms!\p
	It's still soon for a break!"))

	applymovement (35, moves(face_player))
	waitmovement (35)

	checkplayergender
	if(var(VAR_RESULT) == MALE){msgbox(format("Hmm? Come to join the lesson, young man?"))}

	if(var(VAR_RESULT) == FEMALE){msgbox(format("Hmm? Come to join the lesson, young woman?"))}


    msgbox(format("Hmm… I see it in that somber gaze you try to hide.
	\pYou were a soldier. But you were never a warrior. And now you are neither.
	\pSo why are you here? Do you wish for strength?"))

	dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "Yes", "No")

		if (var(VAR_RESULT) == 1) {
		msgbox(format("Very well... if you change your mind, we train here during the day."))
		goto (senseiscriptend)
		}

		if (var(VAR_RESULT) == 0) {
		setvar (VAR_SENSEIQTRAININGQUEST, 1)
		msgbox(format("And what would you use said strength for?"))
			dynmultichoice(0, 0, TRUE, 3, 0, DYN_MULTICHOICE_CB_NONE,
			"To defend myself",
			"To accomplish my goals",
			"To protect others",
			"I don't know")

			if (var(VAR_RESULT) == 0) {
			msgbox(format("I see. You have suffered harm - you are naturally afraid of more..."))
			}
			if (var(VAR_RESULT) == 1) {
			msgbox(format("Your goals? Self-growth, perchance? Some manner of revenge? I hope not..."))
			}
			if (var(VAR_RESULT) == 2) {
			msgbox(format("A worthy pursuit. But that, young one, often requires more resolve than
			strength..."))
			}
			if (var(VAR_RESULT) == 3) {
			msgbox(format("Ah... you are honest, if nothing else. Sometimes we ignore why we
			are drawn to something."))
			}

			msgbox(format("Stand over there. I will impart a lesson to you."))
			closemessage

			fadescreenswapbuffers (FADE_TO_BLACK)
            hidefollower

			fadeoutbgm (1)
			fadeinbgm (1)
			playbgm (MUS_EARTHANDSEA, TRUE)

			//setflag (punchpetalburgmartialartists)
			//clearflag (idlepetalburgmartialartists)

			applymovement (32, moves(face_down))
			applymovement (33, moves(face_down))
			applymovement (34, moves(face_down))

			//removeobject (32)
			//removeobject (33)
			//removeobject (34)

			//addobject (60)
			//addobject (61)
			//addobject (62)

			setobjectxy (35, 20, 8)
			applymovement (35, moves(face_right))
			waitmovement (35)

			setobjectxy (OBJ_EVENT_ID_PLAYER, 24, 8)
			applymovement (OBJ_EVENT_ID_PLAYER, moves(face_left))
			waitmovement (OBJ_EVENT_ID_PLAYER)

			fadescreenswapbuffers (FADE_FROM_BLACK)


		msgbox(format("True martial arts is not about vanquising your opponent's strength with
		your own.
		\pIt's about redirecting said strenght towards a peaceful conclusion.
		\pSince ancient times, people have learnt to do this from Pokémon, which do this
		instinctively with moves like {COLOR GREEN} Counter{COLOR DARK_GRAY}.
		\pI will now teach you said move. Now, I wish you to strike me."))
		closemessage

		playse (SE_M_METRONOME)
		applymovement (OBJ_EVENT_ID_PLAYER, moves(emote_question_mark))
		waitmovement (OBJ_EVENT_ID_PLAYER)

		applymovement (35, moves(walk_in_place_right * 1))
		waitmovement (35)

		msgbox(format("Hoho… fear not. Looks can be deceiving. And that goes for both of us…
		\pDo not hesitate. Strike me!"))

		checkplayergender
		if(var(VAR_RESULT) == MALE){
			
			dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE,
			"Strike with crutch",
			"Low kick")}

		if(var(VAR_RESULT) == FEMALE){
			
			dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE,
			"Kick",
			"Punch")}

			if (var(VAR_RESULT) == 0) {
			goto (playerstrikessensei)
			}

			if (var(VAR_RESULT) == 1) {
			closemessage
			playerstrikessensei:
			playse (SE_FLEE)
			applymovement (OBJ_EVENT_ID_PLAYER, moves(walk_fast_left * 3))
			waitmovement (OBJ_EVENT_ID_PLAYER)


			setvar(VAR_0x8004, 2)  //@ vertical pan
			setvar(VAR_0x8005, 6)  //@ horizontal pan
			setvar(VAR_0x8006, 4)  //@ num shakes
			setvar(VAR_0x8007, 4)  //@ shake delay
			special(ShakeCamera)
			playse (SE_CLICK)
			waitse

			setvar(VAR_0x8004, 4)  //@ vertical pan
			setvar(VAR_0x8005, 8)  //@ horizontal pan
			setvar(VAR_0x8006, 8)  //@ num shakes
			setvar(VAR_0x8007, 4)  //@ shake delay
			playse (SE_EFFECTIVE)
			special(ShakeCamera)


				msgbox(format("{COLOR GREEN}The old man deflects the hit, and returns the blow!"))

				applymovement (35, moves(walk_in_place_right * 1))
				waitmovement (35)

				msgbox(format("See? This was not a clash of your force against mine.
				\pIt was a single motion, where your own blow turned against you.
				\pThis is the secret of the move {COLOR GREEN}Counter{COLOR DARK_GRAY}.
				\pNow, go back to your spot."))
				closemessage

				applymovement (OBJ_EVENT_ID_PLAYER, moves(walk_right * 3, walk_in_place_left))
				waitmovement (OBJ_EVENT_ID_PLAYER)

				msgbox(format("I want you to try performing the move now. Get ready!"))
				closemessage

				playse (SE_PIN)
				applymovement (OBJ_EVENT_ID_PLAYER, moves(emote_exclamation_mark))
				waitse

				playse (SE_FLEE)
				applymovement (35, moves(walk_fast_right * 3))
				waitmovement (35)

				msgbox(format("{COLOR GREEN}The old man draws near with great speed to strike!"))
				playercounterssenseichoice:
					checkplayergender
					if(var(VAR_RESULT) == MALE){
						
						dynmultichoice(0, 0, TRUE, 3, 0, DYN_MULTICHOICE_CB_NONE,
						"Kick as he comes",
						"Dodge and punch back",
						"Trip him with crutch and strike back",)
						goto (counterchoiceresolves)}


					if(var(VAR_RESULT) == FEMALE){
						
						dynmultichoice(0, 0, TRUE, 3, 0, DYN_MULTICHOICE_CB_NONE,
						"Kick as he comes",
						"Block with arm and punch back",
						"Dodge and kick back")}

						counterchoiceresolves:
						if (var(VAR_RESULT) == 0) {
						closemessage
						playse (SE_BALL_THROW)
						waitse
						call (SmallSenseiShake)
						msgbox(format("{COLOR GREEN}The old man dodges nimbly and strikes {PLAYER}!"))

						applymovement (35, moves(walk_in_place_right * 1))
						waitmovement (35)

						msgbox(format("That is not the way. You met my force with your own force.
						\pThat is how the Hoenn army must have taught you....
						\pYou must not think like a mere soldier - think like a warrior!
						\pTry and use my own motion against me. Again!
						\p{COLOR GREEN}The old man attempts to strike again!"))
						goto (playercounterssenseichoice)
						
						}	

						if (var(VAR_RESULT) == 1) {
						closemessage
						call (SmallSenseiShake)

						msgbox(format("{COLOR GREEN}{PLAYER} is unable to dodge the old man's strike!"))
						
						applymovement (35, moves(walk_in_place_right * 1))
						waitmovement (35)

						msgbox(format("{COLOR DARK_GRAY}You understood the principle... but you failed to understand your limits."))						

						checkplayergender
						if(var(VAR_RESULT) == MALE){
							msgbox(format("Those crutches you need for support - they rob you of your agility.
							\pHowever, they may also be turned to weapons at any moment. Again!
							\p{COLOR GREEN}The old man attempts to strike again!"))
							goto (playercounterssenseichoice)
							}

						if(var(VAR_RESULT) == FEMALE){
							msgbox(format("You have only one able hand to block, while I have two to strike you.
							\pThink of what else you may leverage against me. Again!
							\p{COLOR GREEN}The old man attempts to strike again!"))
							goto (playercounterssenseichoice)

							}

							}

						if (var(VAR_RESULT) == 2) {
							closemessage
							checkplayergender
							if(var(VAR_RESULT) == MALE){
							playse (SE_ICE_STAIRS)
							}

							if(var(VAR_RESULT) == FEMALE){
							playse (SE_BALL_THROW)
							waitse
							}

							waitse
							call (SmallSenseiShake)
							msgbox(format("{COLOR GREEN}{PLAYER} has successfuly countered the attack!"))
							playfanfare (MUS_LEVEL_UP)
							msgbox(format("{COLOR GREEN}{PLAYER} learnt the move Counter!"))

							applymovement (35, moves(walk_in_place_right * 1))
							waitmovement (35)

							msgbox(format("Excellent! Not only did you used my own move against me...
							\pYou also understood your own limitations.\pYou have potential as a
							martial artist."))

								fadescreenswapbuffers (FADE_TO_BLACK)
								fadeoutbgm (1)
								fadeinbgm (1)

								gettimeofday
								if (var(VAR_0x8000) == TIME_NIGHT)
								{playbgm (MUS_PANULACAVE, TRUE)}
								else {playbgm (MUS_TEAMGRDUEL, TRUE)}

								//clearflag (punchpetalburgmartialartists)
								//setflag (idlepetalburgmartialartists)

								//addobject (32)
								//addobject (33)
								//addobject (34)

								//removeobject (60)
								//removeobject (61)
								//removeobject (62)

								setobjectxy (35, 22, 8)
								applymovement (35, moves(face_right))
								waitmovement (35)

								setobjectxy (OBJ_EVENT_ID_PLAYER, 23, 8)
								applymovement (OBJ_EVENT_ID_PLAYER, moves(face_left))
								waitmovement (OBJ_EVENT_ID_PLAYER)

								fadescreenswapbuffers (FADE_FROM_BLACK)

								msgbox(format("I hope you never come into peril, and need to use
								{COLOR GREEN}Counter{COLOR DARK_GRAY}...
								\pBut if you do, and feel yourself in need of even more training...
								\pI would be happy to be your teacher. Now, take care out there."))



						}	


				}

				}


	setvar (VAR_SENSEIQTRAININGQUEST, 1)

	senseiscriptend:

	applymovement (35, moves(face_up))
	waitmovement (35)

	release

	}
	}


		script SmallSenseiShake {
			
		
			setvar(VAR_0x8004, 4)  //@ vertical pan
			setvar(VAR_0x8005, 8)  //@ horizontal pan
			setvar(VAR_0x8006, 8)  //@ num shakes
			setvar(VAR_0x8007, 4)  //@ shake delay
			playse (SE_EFFECTIVE)
			special(ShakeCamera)
			waitse

			}

script ArcadeLotFuelScooperTruck1Pointer {

	lock
	
	msgbox(format("This vehicle might have fuel... but this is not the spot to scoop it from."))
	dofieldeffectsparkle (10, 31, 9)
	release

}


script ArcadeLotFuelScooperTruck1 {
	
	lock

	if (flag(arcadelottruck1fuel))

	{msgbox(format("I've already scoped fuel from this truck. Its tank is empty."))
	goto (endoffuelscooper)}

	if (!flag(arcadelottruck1fuel))

	{

    if(var(VAR_FUELSCOOPERLEVEL) == 4)
    {msgbox(format("This vehicle might have fuel... but the {COLOR GREEN}Fuel Scooper{COLOR DARK_GRAY}'s tank is full!
	\pI should take this to the manager of {COLOR GREEN}Petalburg's Hardware Store."))
	goto (endoffuelscooper)}

	msgbox(format("This vehicle might have fuel...\nUse the {COLOR GREEN}Fuel Scooper{COLOR DARK_GRAY}?"))
	dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "Yes", "No")

		if (var(VAR_RESULT) == 1) {
		goto (endoffuelscooper)
		}

		if (var(VAR_RESULT) == 0) {

			closemessage

			playse (SE_M_GIGA_DRAIN)
			waitse
			playse (SE_M_GIGA_DRAIN)
			waitse


			addvar (VAR_FUELSCOOPERLEVEL, + 1)

        	if(var(VAR_FUELSCOOPERLEVEL) == 1){
			msgbox(format("The {COLOR GREEN}Fuel Scooper{COLOR DARK_GRAY} tank is now a quarter full!"))
			}

        	if(var(VAR_FUELSCOOPERLEVEL) == 2){
			msgbox(format("The {COLOR GREEN}Fuel Scooper{COLOR DARK_GRAY} tank is now half full!"))
			}

        	if(var(VAR_FUELSCOOPERLEVEL) == 3){
			msgbox(format("The {COLOR GREEN}Fuel Scooper{COLOR DARK_GRAY} tank is now three quarters full!"))
			}

        	if(var(VAR_FUELSCOOPERLEVEL) == 4){
			playfanfare (MUS_RG_PHOTO)
			msgbox(format("The {COLOR GREEN}Fuel Scooper{COLOR DARK_GRAY} tank is now completely full!"))
			}



			setvar(VAR_0x8004, 2)  //@ vertical pan
			setvar(VAR_0x8005, 6)  //@ horizontal pan
			setvar(VAR_0x8006, 4)  //@ num shakes
			setvar(VAR_0x8007, 4)  //@ shake delay
			playse (SE_TRUCK_DOOR)
			special(ShakeCamera)


			clearflag (angryfuelowner)
			addobject (59)
			waitse

			playse (SE_LEDGE)
			applymovement (59, moves(jump_down * 1, face_left))
			waitse

			playse (SE_PIN)
			applymovement (59, moves(emote_exclamation_mark))
			waitmovement

			msgbox(format("You thief! That's my hard-earned gasoline you're taking!"))
			trainerbattle_no_intro(TRAINER_RICKY_1, ConstructionWorkerM102_Outro)

			msgbox(format("Wait a minute - that {COLOR GREEN}Fuel Scooper{COLOR DARK_GRAY}!
			You're working for the Hardware Store!
			\pThose jerks have been sending idiots like you to steal fuel for them...
			\pSo they can resell it to the same people they're stealing from!
			\pBah, I ain't servicing there anymore, even if I have to walk everywhere.
			\pI hope whatever they're paying you for this is worh it! Piss off!"))
			setflag (FLAG_SAFE_FOLLOWER_MOVEMENT)

			applymovement (59, moves(walk_fast_right * 2, walk_fast_up * 3, walk_fast_right * 4))
			waitmovement (59)
			removeobject (59)
			setflag (angryfuelowner)
			setflag (arcadelottruck1fuel)

			}

			}

		endoffuelscooper:
		release

}


script PetalburgTrendyPhraseGuitarist {
	lock
	call (Common_EventScript_BufferTrendyPhrase)
	msgbox(format("Listen to my new song... {STR_VAR_1}!
	\p What, you don't know the phrase? It's like, the Rebel Zone's slogan right now!
	\p{STR_VAR_1}!!!!!"))
	release
}

script PetalburgWildZoneNPCIntroTrigger {

	lock
	setflag (FLAG_SAFE_FOLLOWER_MOVEMENT)
	playse (SE_PIN)
	applymovement(12, moves(emote_exclamation_mark))
	waitmovement (12)
	applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
	goto (PetalburgWildZoneNPC)

}

script PetalburgWildZoneNPCBuyTrigger {
	setflag (FLAG_SAFE_FOLLOWER_MOVEMENT)
	applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
	goto (PetalburgWildZoneNPC)

}

script PetalburgWildZoneNPCLeaveTrigger {
	
	lock
	setflag (FLAG_SAFE_FOLLOWER_MOVEMENT)
	playse (SE_M_METRONOME)
	applymovement(12, moves(emote_question_mark))
	waitmovement (12)
	applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
	waitmovement
	goto (PetalburgWildZoneNPC)

}


script PetalburgWildZoneNPC {
	lock
	setflag (FLAG_SAFE_FOLLOWER_MOVEMENT)

	if (var(VAR_PETALBURG_WILD_ZONE) == 2) {

	applymovement(12, moves(face_player))

	msgbox (format("Done already?"))

		dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE,
		"Yes",
		"No")

			if (var(VAR_RESULT) == 1) {

			msgbox (format("No hurries then - enjoy the time you got left!"))
			closemessage
			applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right * 1))
			waitmovement (OBJ_EVENT_ID_PLAYER)
			goto (endofpetalburgwildzonenpc)

			}
	
			if (var(VAR_RESULT) == 0) {
			msgbox (format("Really? Well, I'll have your leftover Pokéballs back then!"))	
			
			closemessage
			playse (SE_BALL_TRAY_BALL)
			waitse
			removeitem (ITEM_PARK_BALL, 30)
			msgbox (format("Come back soon!"))
			closemessage
			applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left * 1))
			waitmovement (OBJ_EVENT_ID_PLAYER)

			//special (ExitSafariMode)
			clearflag (FLAG_TEMP_HIDE_FOLLOWER)
			setvar (VAR_PETALBURG_WILD_ZONE, 1)

			goto (endofpetalburgwildzonenpc)
	
	}
	
	}

	if (var(VAR_PETALBURG_WILD_ZONE) == 0) {

		setvar (VAR_PETALBURG_WILD_ZONE, 1)

		applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
			checkplayergender
			if(var(VAR_RESULT) == MALE)
			{msgbox (format("Oh hey, you're the guy from Oldale Warehouse! Remember me!?"))}

			if(var(VAR_RESULT) == FEMALE)
			{msgbox (format("Oh hey, you're the girl from Oldale Warehouse! Remember me!?"))}

		msgbox (format("I'm the Rebel who was left behind there. But that was the old me!
		\pElectrike and I, we're done working for others!"))
		applymovement (12, moves(face_left))
		applymovement (52, moves(face_right))
		waitmovement (52)
		msgbox (format("We've started our own business, to make it big on our own - right buddy?"))

		playse (SE_LEDGE)
		applymovement (52, moves(jump_in_place_right))
		waitmovement (52)
		playmoncry (SPECIES_ELECTRIKE, CRY_MODE_HIGH_PITCH)

		msgbox (format("IIIKE!"))
		closemessage

		applymovement (12, moves(walk_in_place_right))

		applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_right))

		special (SpawnCameraObject)
		applymovement (OBJ_EVENT_ID_CAMERA, moves(walk_right * 3, walk_up * 2))
		waitmovement(OBJ_EVENT_ID_CAMERA)
		special (RemoveCameraObject)


		msgbox (format("And this is it - the first and only Wild Zone in Petalburg!"))



		petalburgwildzoneexplanation:

		msgbox (format("It's simple - I give you Pokéballs, and you enter the area
		to catch rare Pokémon."))

		special (SpawnCameraObject)
		applymovement (OBJ_EVENT_ID_CAMERA, moves(walk_left * 3, walk_down * 2))
		waitmovement(OBJ_EVENT_ID_CAMERA)
		special (RemoveCameraObject)

		applymovement (12, moves(walk_in_place_down))
		applymovement (52, moves(face_down))

		applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_up))
		waitmovement (OBJ_EVENT_ID_PLAYER)
 

		msgbox (format("It's 100¥ per entry. You want in?"))
		goto (petalburgwildzonechoice)
		
		}


	if (var(VAR_PETALBURG_WILD_ZONE) == 1) {

		applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_up))
		waitmovement (OBJ_EVENT_ID_PLAYER)

		msgbox (format("Welcome back! Want a round of the Wild Zone?"))
		petalburgwildzonechoice:
		showmoneybox (18, 0)


		dynmultichoice(0, 0, TRUE, 3, 0, DYN_MULTICHOICE_CB_NONE,
		"Yes",
		"No",
		"Wild Zone?")
	
			if (var(VAR_RESULT) == 0) {

				checkmoney (100)
			
				if (var(VAR_RESULT) == FALSE) {
				msgbox (format("Hey, you ain't got enough! It's a Wild Zone pal, not a Free Zone!"))
				hidemoneybox
				goto (endofpetalburgwildzonenpc)		
				}

				if (var(VAR_RESULT) == TRUE) {
					removemoney (100)
					updatemoneybox
					playse (SE_RG_SHOP)
					waitse
					hidemoneybox

					msgbox (format("Alrighty! Here's your Pokéballs!"))
					giveitem (ITEM_PARK_BALL, 30)
					//playse (SE_BALL_TRADE)
					//waitse

					msgbox (format("Have a good time!"))
					//hidefollower
					//setflag (FLAG_TEMP_HIDE_FOLLOWER)

					
					applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right * 2))
					waitmovement (OBJ_EVENT_ID_PLAYER)

					//special (EnterSafariMode)
					setvar (VAR_PETALBURG_WILD_ZONE, 2)
					goto (endofpetalburgwildzonenpc)

				}

			}

			if (var(VAR_RESULT) == 1) {
			msgbox (format("You sure? You're going to miss on some raaaare Pokémon..."))
			closemessage
			hidemoneybox
			applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left * 1))
			waitmovement (OBJ_EVENT_ID_PLAYER)
			goto (endofpetalburgwildzonenpc)
			}

			if (var(VAR_RESULT) == 2) {
			msgbox (format("Geez, I explained this to you already."))
			closemessage
			hidemoneybox

			applymovement (12, moves(walk_in_place_right))

			applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_right))

			special (SpawnCameraObject)
			applymovement (OBJ_EVENT_ID_CAMERA, moves(walk_right * 3, walk_up * 2))
			waitmovement(OBJ_EVENT_ID_CAMERA)
			special (RemoveCameraObject)


			goto (petalburgwildzoneexplanation)
			}


	}

	endofpetalburgwildzonenpc:
	release
}


	script PetalburgWildZoneTourist {
	
	lock
	applymovement (62, moves(face_player))
	msgbox (format("This Wild Zone is a bit dirtier than the one we have in Lumiose...
	\pBut it's an interesting regional spin!"))
	playmoncry (SPECIES_NINKABURI, CRY_MODE_NORMAL)
	playse (SE_M_HORN_ATTACK)
	applymovement (62, moves(walk_in_place_right))
	waitmovement (62)
	msgbox (format("Ouch, something just bit me...!"))
	release

	}



	script PetalburgBurgerMunchlax {

	lock
	playmoncry (SPECIES_MUNCHLAX, CRY_MODE_WEAK)
	msgbox (format("Mun-muuun...
	\pThe Munchlax is scraping the griller for leftover meat."))
	release

	}