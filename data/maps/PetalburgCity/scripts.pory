script PetalburgRiotLowerRebel {
    lock
    setflag (FLAG_SAFE_FOLLOWER_MOVEMENT)
    msgbox (format("Get it through your head, you thick-skulled lapdog!\pWe want no bridges, no
	Safemon, and no shady corpos messing around!"))
    release
    
}

script PetalburgRiotLowerDevon {
    lock
    setflag (FLAG_SAFE_FOLLOWER_MOVEMENT)
    msgbox (format("Stop it! Why are you Rebels so ungrateful?\pDevon wants to rebuild this area,
	and all you do is get in the way!"))
    release
    
}




script HardwareStoreClerk {
	

		if (!flag (foughtwarehousescavenger2) && !flag(scavengergivesobjectspotter)) {}
		//never met scavengers

		if (flag (foughtwarehousescavenger2) && !flag(scavengergivesobjectspotter)) {}
		//lost against scavenger F
		if (flag (foughtwarehousescavenger2) && flag(scavengergivesobjectspotter)) {}
		//how's that object spotter treating you.

}

script JimmyMcGligarSewersIdle {
		if(var(VAR_JIMMYQUESTPROGRESS) == 0 && !flag(conartistaskeddistract)) //this means Player never interacted
		//with Jimmy
		{release}

		if(var(VAR_JIMMYQUESTPROGRESS) == 0 && flag(conartistaskeddistract)) //this means Jimmy asked for help
		//but player never helped him
		{}

	    if(var(VAR_JIMMYQUESTPROGRESS) == 1 && flag(conartistescaped) && flag(!betrayedconcordconartist)) //this means Player helped Jimmy but cleared Warehouse
		//before getting reward from Jimmy, so he gives Tamarakku egg: "I never thanked you!"
		{}

	    if(var(VAR_JIMMYQUESTPROGRESS) == 2 && flag(conartistescaped) && flag(helpedconcordconartist)) //this means Player helped Jimmy and obtained egg
   		//Jimmy has Player's number so he can call them
		{}

	    if(var(VAR_JIMMYQUESTPROGRESS) == 2 && flag(conartistescaped) && flag(betrayedconcordconartist)) //this means Player betrayed Jimmy
		{}	

	    if(var(VAR_JIMMYQUESTPROGRESS) == 3){}	//Player helped Jimmy and even bought Exeggcute egg

		//regardless of result, setvar (VAR_JIMMYQUESTPROGRESS, 4)
}