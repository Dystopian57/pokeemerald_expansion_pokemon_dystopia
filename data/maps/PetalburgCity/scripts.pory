script PetalburgArcadeGuardsGoAway {
    applymovement (53, moves(walk_in_place_right))
    applymovement (54, moves(walk_in_place_right))
	waitmovement (54)
    msgbox(format("Hm? Arcade's off limits, kid. We're on high alert."))
    applymovement (53, moves(walk_in_place_down))
    applymovement (54, moves(walk_in_place_up))
	waitmovement (54)
	releaseall
}

script PetalburgSmokerMilitia {
    lock
    setflag (FLAG_SAFE_FOLLOWER_MOVEMENT)
	applymovement (57, moves(face_player))
	waitmovement (57)

	if (!flag(petalburgsmokergivesligther))

    {msgbox (format("Today's training was brutal - was dying for a smoke break...
	\p... but maybe it's the cigs that make it brutal!?
	\pHere, take this from me!"))
	giveitem (ITEM_FLAME_ORB)
	setflag (petalburgsmokergivesligther)}

	else {
	msgbox (format("... I mean, I already lighted this one, so may as well smoke it.
	\pAnd I also got some matches, it'd be a waste not to use them."))}

	applymovement (57, moves(face_down))
	waitmovement (57)
    release
    
}

script PetalburgMilitiaSnackGuy {
    lock

		if (!flag(militiadailysnack))
		{
		random (2)
		copyvar (VAR_TEMP_1, VAR_RESULT)

		switch (var(VAR_RESULT))
		{case 0:
			msgbox(format("HIII-YA! HIII-YA! Arf, arf...\pWhen doing exercise, gotta keep hydrated! Here,
			have this!"))
			giveitem (ITEM_FRESH_WATER)
		case 1:
			msgbox(format("HIII-YA! HIII-YA! Arf, arf...\pNothing like an energy bar to keep energy up! Here,
			have one!"))
			giveitem (ITEM_ENERGY_POWDER)
		}
		setflag (militiadailysnack)
		}

		else {	msgbox(format("Thanks for cheering us up! Come back tomorrow too! HIII-YA!"))
				
				}

    releaseall
    }

