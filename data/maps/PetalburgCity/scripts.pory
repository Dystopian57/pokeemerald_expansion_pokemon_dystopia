PetalburgCity_Text_WhereIsWally:
	.string "Where has our WALLY gone?\p"
	.string "We have to leave for VERDANTURF TOWN\n"
	.string "very soon…$"

PetalburgCity_Text_AreYouRookieTrainer:
	.string "Hiya! Are you maybe…\n"
	.string "A rookie TRAINER?\p"
	.string "Do you know what POKéMON TRAINERS\n"
	.string "do when they reach a new town?\p"
	.string "They first check what kind of GYM\n"
	.string "is in the town.$"

PetalburgCity_Text_ThisIsPetalburgGym:
	.string "See? This is PETALBURG CITY's GYM.$"

PetalburgCity_Text_ThisIsGymSign:
	.string "This is the GYM's sign. Look for it\n"
	.string "whenever you're looking for a GYM.$"

PetalburgCity_Text_WaterReflection:
	.string "My face is reflected in the water.\p"
	.string "It's a shining grin full of hope…\p"
	.string "Or it could be a look of somber silence\n"
	.string "struggling with fear…\p"
	.string "What do you see reflected in your face?$"

PetalburgCity_Text_FullPartyExplanation:
	.string "Let's say you have six POKéMON.\n"
	.string "If you catch another one…\p"
	.string "It is automatically sent to a STORAGE\n"
	.string "BOX over a PC connection.$"

PetalburgCity_Text_GymSign:
	.string "PETALBURG CITY POKéMON GYM\n"
	.string "LEADER: NORMAN\l"
	.string "“A man in pursuit of power!”$"

PetalburgCity_Text_CitySign:
	.string "PETALBURG CITY\n"
	.string "“Where people mingle with nature.”$"

PetalburgCity_Text_WallyHouseSign:
	.string "WALLY'S HOUSE$"

PetalburgCity_Text_AreYouATrainer:
	.string "Excuse me!\p"
	.string "Let me guess, from the way you're\n"
	.string "dressed, are you a POKéMON TRAINER?$"

PetalburgCity_Text_WellMaybeNot:
	.string "… … … … … …\p"
	.string "Well, maybe not.\n"
	.string "Your clothes aren't all that dirty.\p"
	.string "You're either a rookie TRAINER,\n"
	.string "or maybe you're just an ordinary kid.$"

PetalburgCity_Text_ImLookingForTalentedTrainers:
	.string "I'm roaming the land in search of\n"
	.string "talented TRAINERS.\p"
	.string "I'm sorry to have taken your time.$"

`


mapscripts PetalburgCity_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: DayNightMusicPetalburgCity
    MAP_SCRIPT_ON_LOAD: DayNightMusicPetalburgCity
    MAP_SCRIPT_ON_TRANSITION: PetalburgRiotSpawn
    MAP_SCRIPT_ON_LOAD: PetalburgRiotSpawn
    MAP_SCRIPT_ON_FRAME_TABLE: DayNightMusicPetalburgCity}
	

script DayNightMusicPetalburgCity {
	gettimeofday
		if (var(VAR_0x8000) == TIME_MORNING)
		{goto (enddaynightpetalburgcity)}

		if (var(VAR_0x8000) == TIME_DAY)
		{goto (enddaynightpetalburgcity)}

		if (var(VAR_0x8000) == TIME_EVENING)
		{goto (enddaynightpetalburgcity)}

		if (var(VAR_0x8000) == TIME_NIGHT)
		{playbgm (MUS_PANULACAVE, TRUE)
		goto (enddaynightpetalburgcity)}

enddaynightpetalburgcity:
}

script PetalburgRiotSpawn {

	if (!flag(petalburgriotstopped))
	{setvar (VAR_PETALBURG_RIOT_POSITION, 0)
	setflag (petalburgriothidecivilians)
	clearflag (petalburgriotstopped)}

	if (flag(petalburgriotendedforgood))
	{setflag (petalburgriotstopped)}

	callnative (UpdateFollowingPokemon)
}

//clearflag (cigarettepop)


//TRAINER_GEORGIA
//TRAINER_DAWSON


script PetalburgRiotRebelAdminStart {
	setvar (VAR_PETALBURG_RIOT_POSITION, 1) //this means rebel start position
}

script PetalburgRiotDevonAdminStart {
	setvar (VAR_PETALBURG_RIOT_POSITION, 2) //this means devon start position
}

script PetalburgRiotDevonAdminStartLeave {
	setvar (VAR_PETALBURG_RIOT_POSITION, 0) 
}

script PetalburgRiotRebelAdminStartLeave {
	setvar (VAR_PETALBURG_RIOT_POSITION, 0) 
}


script PetalburgRiotDontblocktheway {
		lock
		random (2)
		copyvar (VAR_TEMP_1, VAR_RESULT)

		switch (var(VAR_RESULT))
		{case 0:goto (PetalburgRiotDontblockthewayRebel)
		case 1: goto (PetalburgRiotDontblockthewayDevon)
		}
}


script PetalburgRiotDontblockthewayRebel {
		lock
		setflag (FLAG_SAFE_FOLLOWER_MOVEMENT)
		playse (SE_PIN)
		applymovement(41, moves(emote_exclamation_mark))
		waitse
		msgbox (format("Hey, get off the way! We're rioting here! We're RIOTING HERE!"))
		closemessage
		applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down * 1))
		waitmovement (OBJ_EVENT_ID_PLAYER)
		release
}

script PetalburgRiotDontblockthewayDevon {
		lock
		setflag (FLAG_SAFE_FOLLOWER_MOVEMENT)
		playse (SE_PIN)
		applymovement(40, moves(emote_exclamation_mark))
		waitse
		msgbox (format("Dear citizen, for your own safety, you must evacuate immediately!"))
		closemessage
		applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down * 1))
		waitmovement (OBJ_EVENT_ID_PLAYER)
		release
}

script PetalburgRiotRebelLead {
	lock
	applymovement (46, moves(face_player))
	waitmovement (46)
	playmoncry (SPECIES_GLIGAR, CRY_MODE_NORMAL)
	msgbox(format("GLIIII!"))
	applymovement (46, moves(face_right))
	waitmovement (46)
	release
}

script PetalburgRiotDevonLead {
	lock
	applymovement (45, moves(face_player))
	waitmovement (45)
	playmoncry (SPECIES_ARYSTAL, CRY_MODE_NORMAL)
	msgbox(format("R-riiii...!"))
	applymovement (45, moves(face_left))
	waitmovement (45)
	release
}


script PetalburgRiotCutscene {
	//lock
	setflag (FLAG_SAFE_FOLLOWER_MOVEMENT)
	fadeoutbgm (1)
	fadeinbgm (1)
	playbgm (MUS_BOSSDRILLDOZER, TRUE)


	special (SpawnCameraObject)
		if (var(VAR_PETALBURG_RIOT_POSITION) == 1) {
		applymovement (OBJ_EVENT_ID_CAMERA, moves(walk_right * 2))
		}
		if (var(VAR_PETALBURG_RIOT_POSITION) == 2) {
		applymovement (OBJ_EVENT_ID_CAMERA, moves(walk_left * 2))
		}
    waitmovement(OBJ_EVENT_ID_CAMERA)
	applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_up * 2))
    waitmovement(OBJ_EVENT_ID_CAMERA)


	special (RemoveCameraObject)

	applymovement(41, moves(walk_in_place_right))
    msgbox (format("The people is done with your greed, you Devon scum!\p
	We want free Pokémon healthcare back, and we want it NOW!"))
	closemessage

	playse (SE_APPLAUSE)
    msgbox (format("{COLOR RED}Hell yeah! Down with the corpos! Down with the corpos!"))

	applymovement(40, moves(walk_in_place_left))
    msgbox (format("Rowdy citizens of Petalburg - look around you! Hoenn is in shambles!
	\pIf we are to rebuild, funds must be collected.\pIt is a small sacrifice today, for a
	better future tomorrow."))
	closemessage


	playse (SE_APPLAUSE)
    msgbox (format("{COLOR BLUE}Yes! It's fair! It's the only way! Stop making things harder!"))

	applymovement(41, moves(walk_in_place_right))
    msgbox (format("Then have Mr. Stone foot the bill! Not the little people!"))
	closemessage


	playse (SE_APPLAUSE)
    msgbox (format("{COLOR RED}Yeeees! Eat the rich, eat the rich!"))

    msgbox (format("{COLOR GREEN}A clash between {COLOR RED}Rebel{COLOR DARK_GRAY} {COLOR GREEN}and {COLOR BLUE}Devon{COLOR GREEN} forces is in full force… what to do?"))
		dynmultichoice(0, 0, TRUE, 4, 0, DYN_MULTICHOICE_CB_NONE, "Fight Devon", "Fight Rebels", "Fight both", "Do nothing")

		if (var(VAR_RESULT) == 0) {
			if (var(VAR_PETALBURG_RIOT_POSITION) == 1) {
			closemessage
			applymovement (OBJ_EVENT_ID_PLAYER, moves(walk_in_place_right))
			applymovement (OBJ_EVENT_ID_FOLLOWER, moves(walk_in_place_right))
			}

			if (var(VAR_PETALBURG_RIOT_POSITION) == 2) {
			closemessage
			applymovement (OBJ_EVENT_ID_PLAYER, moves(walk_left * 4, walk_in_place_right))
			applymovement (OBJ_EVENT_ID_FOLLOWER, moves(walk_left * 2, walk_in_place_right))
			}
			applymovement (OBJ_EVENT_ID_FOLLOWER, moves(face_right))
			waitmovement (OBJ_EVENT_ID_FOLLOWER)
			waitmovement (OBJ_EVENT_ID_PLAYER)
			applymovement (41, moves(walk_in_place_down))
			waitmovement (41)		
   		 	msgbox (format("Hah! Take a look, you shitty corpos! The people is with us!"))
			applymovement (41, moves(face_right))
			waitmovement (41)	
			applymovement (40, moves(walk_in_place_left))
			waitmovement (40)	
   		 	msgbox (format("They simply fall prey to your lies. A shame…\pFor the sake of Hoenn, I must
			have order restored!"))
			trainerbattle_no_intro(TRAINER_DAWSON, Dawson_Outro)


			applymovement (40, moves(walk_in_place_left))
			waitmovement (40)
			//applymovement (OBJ_EVENT_ID_PLAYER, moves(walk_in_place_right))
			//waitmovement (OBJ_EVENT_ID_PLAYER)

   		 	msgbox (format("You will soon realize how wrong your thoughtless vandalism is...
			\p Everyone, back to base."))
			closemessage

			playse (SE_FLEE)
			fadescreenswapbuffers (FADE_TO_BLACK)

			removeobject (36)
			removeobject (40)
			removeobject (42)
			removeobject (45)
			removeobject (48)
			removeobject (49)

			waitse
			fadescreenswapbuffers (FADE_FROM_BLACK)

			applymovement (41, moves(walk_in_place_down))
			applymovement (OBJ_EVENT_ID_PLAYER, moves(walk_in_place_up))
			waitmovement (OBJ_EVENT_ID_PLAYER)
				checkplayergender
				if(var(VAR_RESULT) == MALE){msgbox (format("Good job, man. That'll send Devon a good message."))}

				if(var(VAR_RESULT) == FEMALE){msgbox (format("Good job, girl. That'll send Devon a good message."))}

			msgbox (format("But they'll most likely be back tomorrow, so we will need to as well.
			\pCounting on you for the next raid. See ya!"))
			closemessage

			fadescreenswapbuffers (FADE_TO_BLACK)

			playse (SE_M_STRENGTH)
			waitse
			playse (SE_M_STRENGTH)
			waitse
			playse (SE_M_BRICK_BREAK)
			waitse



			removeobject (37)
			removeobject (38)
			removeobject (39)
			removeobject (41)
			removeobject (46)
			removeobject (50)



			addobject (9)
			addobject (10)
			addobject (11)
			addobject (15)
			addobject (51)

			clearflag (rebelswonpetalburgriot)
			setflag (petalburgriotstopped)

			clearflag (petalburgriothidecivilians)

			waitse
			fadescreenswapbuffers (FADE_FROM_BLACK)
			msgbox (format("{COLOR RED}Rebels{COLOR DARK_GRAY} got inside the center before leaving, and made a mess of things!"))

			goto (endofpetalburgriotscript)
		}

		if (var(VAR_RESULT) == 1) {
			if (var(VAR_PETALBURG_RIOT_POSITION) == 1) {
			closemessage
			applymovement (OBJ_EVENT_ID_PLAYER, moves(walk_right * 4, walk_in_place_left))
			applymovement (OBJ_EVENT_ID_FOLLOWER, moves(walk_right * 2, walk_in_place_left))
			}

			if (var(VAR_PETALBURG_RIOT_POSITION) == 2) {
			applymovement (OBJ_EVENT_ID_PLAYER, moves(walk_in_place_left))
			applymovement (OBJ_EVENT_ID_FOLLOWER, moves(walk_in_place_left))
			}
			waitmovement (OBJ_EVENT_ID_FOLLOWER)
			waitmovement (OBJ_EVENT_ID_PLAYER)
			applymovement (40, moves(walk_in_place_down))
			waitmovement (40)	
   		 	msgbox (format("Ah, thank you, citizen! You're helping preserve peace in Petalburg."))
			applymovement (40, moves(face_left))
			waitmovement (40)	
			applymovement (41, moves(walk_in_place_right))
			waitmovement (41)	
   		 	msgbox (format("Peace? There'll never be peace, until you stop bleeding this region dry!
			\pDown with Devon… and down with lapdogs like you!"))
			trainerbattle_no_intro(TRAINER_GEORGIA, Georgia_Outro)


			applymovement (41, moves(walk_in_place_right))
			waitmovement (41)
			//applymovement (OBJ_EVENT_ID_PLAYER, moves(walk_in_place_left))
			//waitmovement (OBJ_EVENT_ID_PLAYER)

   		 	msgbox (format("You're lucky this guy showed up. But we'll be back tomorrow."))
			closemessage
			playse (SE_LEDGE)
			applymovement (41, moves(jump_in_place_right))
			waitmovement (41)

   		 	msgbox (format("Back to base, everyone!"))

			playse (SE_FLEE)
			fadescreenswapbuffers (FADE_TO_BLACK)

			removeobject (37)
			removeobject (38)
			removeobject (39)
			removeobject (41)
			removeobject (48)
			removeobject (50)
			removeobject (43)
			removeobject (46)
			removeobject (47)
			applymovement (49, moves(face_up))

			waitse
			fadescreenswapbuffers (FADE_FROM_BLACK)

			applymovement (40, moves(walk_in_place_down))	
			applymovement (OBJ_EVENT_ID_PLAYER, moves(walk_in_place_up))
			waitmovement (OBJ_EVENT_ID_PLAYER)
   		 	msgbox (format("Thanks again, citizen. You have done a great deed for Hoenn today.
			\pThe center was damaged, but we should still be able to offer our services.
			\pHowever, we will need to increase the healing prices to compensate for the damages…
			\pNot to mention, the Rebels will surely be back tomorrow. So I hope we can count
			with your continued assistance.\pFarewell now, and take care in this dangerous
			city."))

			fadescreenswapbuffers (FADE_TO_BLACK)

			removeobject (36)
			removeobject (40)
			removeobject (42)
			removeobject (49)
			removeobject (45)
			removeobject (46)
			removeobject (48)

			setflag (petalburgriotstopped)

			setflag (devonwonpetalburgriot)

			addobject (9)
			addobject (10)
			addobject (11)
			addobject (15)
			addobject (51)

			clearflag (petalburgriothidecivilians)

			waitse
			fadescreenswapbuffers (FADE_FROM_BLACK)

			goto (endofpetalburgriotscript)
			
		}

		if (var(VAR_RESULT) == 2) {
			closemessage
			if (var(VAR_PETALBURG_RIOT_POSITION) == 1) {
			applymovement (OBJ_EVENT_ID_PLAYER, moves(walk_right * 2, walk_up * 1, walk_in_place_down))
			applymovement (OBJ_EVENT_ID_FOLLOWER, moves(walk_right * 3, walk_in_place_down))
			}

			if (var(VAR_PETALBURG_RIOT_POSITION) == 2) {
			applymovement (OBJ_EVENT_ID_PLAYER, moves(walk_left * 2, walk_up * 1, walk_in_place_down))
			applymovement (OBJ_EVENT_ID_FOLLOWER, moves(walk_left * 1, walk_in_place_down))
			}

			waitmovement (OBJ_EVENT_ID_PLAYER)


			playse (SE_PIN)
			applymovement (41, moves(emote_exclamation_mark))
			waitse
			applymovement (OBJ_EVENT_ID_PLAYER, moves(walk_in_place_left))
			//waitmovement (OBJ_EVENT_ID_PLAYER)
			applymovement (OBJ_EVENT_ID_FOLLOWER, moves(face_left))
			waitmovement (OBJ_EVENT_ID_FOLLOWER)

   		 	msgbox (format("What? Don't get in the way, you meddlesome loser!"))

			playse (SE_PIN)
			applymovement (40, moves(emote_exclamation_mark))
			waitse
			applymovement (OBJ_EVENT_ID_PLAYER, moves(walk_in_place_right))
			//waitmovement (OBJ_EVENT_ID_PLAYER)
			applymovement (OBJ_EVENT_ID_FOLLOWER, moves(face_right))
			waitmovement (OBJ_EVENT_ID_FOLLOWER)

   		 	msgbox (format("You would challenge us both? That is true anarchy..."))

			applymovement (41, moves(walk_in_place_right))
			applymovement (40, moves(walk_in_place_left))
			waitmovement (40)

   		 	msgbox (format("{COLOR BLUE}I cannot allow it!\n{COLOR RED}Piss off!"))
			trainerbattle_two_trainers (TRAINER_GEORGIA, Georgia_MultiOutro, 
			TRAINER_DAWSON, Dawson_MultiOutro)



				playse (SE_PIN)
				applymovement(42, moves(emote_exclamation_mark))
				playse (SE_PIN)
				applymovement(49, moves(emote_exclamation_mark, face_up))
				waitse
				playse (SE_PIN)
				applymovement(36, moves(emote_exclamation_mark))
				waitse

				playse (SE_PIN)
				applymovement(38, moves(emote_exclamation_mark))
				playse (SE_PIN)
				applymovement(39, moves(emote_exclamation_mark))
				playse (SE_PIN)
				applymovement(48, moves(emote_exclamation_mark, face_up))

				playse (SE_APPLAUSE)


				checkplayergender
				if(var(VAR_RESULT) == MALE){msgbox (format("He defeated both admins...! Who's that trainer?"))}

				if(var(VAR_RESULT) == FEMALE){msgbox (format("She defeated both admins...! Who's that trainer?"))}



			applymovement (40, moves(walk_in_place_left))
			//applymovement (OBJ_EVENT_ID_PLAYER, moves(walk_in_place_right))
			//waitmovement (OBJ_EVENT_ID_PLAYER)

			fadeoutbgm (1)
			fadeinbgm (1)
			playbgm (MUS_CALM, TRUE)	

   		 	msgbox (format("Your feat seems to have defused the situation. To avoid new escalation..."))


			fadeinbgm (1)

			//playbgm (MUS_ENCOUNTERPINCHERS, TRUE)
			playbgm (MUS_CALM, TRUE)
			

   		 	msgbox (format("I propose a truce, and a compromise.\pTo match the standard of living here in
			Petalburg, the healing fees in this Devon Center will receive a 25% discount.
			\pOn the condition, however...
			\pThat you Rebels repair the damage you just caused.\pSurely this is a reasonable
			deal."))



			applymovement (41, moves(walk_in_place_right))
			applymovement (OBJ_EVENT_ID_PLAYER, moves(walk_in_place_left))
			waitmovement (OBJ_EVENT_ID_PLAYER)

   		 	msgbox (format("Counter offer... make it a 50% discount, or we will make the damage worse."))

			applymovement (40, moves(walk_in_place_left))
			applymovement (OBJ_EVENT_ID_PLAYER, moves(walk_in_place_right))
			waitmovement (OBJ_EVENT_ID_PLAYER)
   		 	msgbox (format("Hmpf... you negotiate well, for a criminal. Very well.\pThank you, trainer,
			for helping us arrive at this truce.\pIt is far from ideal, but it will suffice for now."))

			applymovement (41, moves(walk_in_place_right))
			waitmovement (41)
			applymovement (40, moves(walk_in_place_left))
			waitmovement (40)

   		 	msgbox (format("{COLOR BLUE}Grunts, to base!\n{COLOR RED}Pack it up, everyone!"))

			fadescreenswapbuffers (FADE_TO_BLACK)

			removeobject (36)
			removeobject (40)
			removeobject (42)
			removeobject (49)
			removeobject (45)
			removeobject (46)
			removeobject (48)

			removeobject (38)
			removeobject (39)
			removeobject (50)

			removeobject (47)
			removeobject (43)
			removeobject (37)

			removeobject (41)



			addobject (9)
			addobject (10)
			addobject (11)
			addobject (15)
			addobject (51)

			setvar (VAR_PETALBURG_RIOT_POSITION, 3)

			setflag (devonwonpetalburgriot)
			setflag (rebelswonpetalburgriot)

			setflag (petalburgriotstopped)
			setflag (petalburgriotendedforgood)
			clearflag (petalburgriothidecivilians)

			fadescreenswapbuffers (FADE_FROM_BLACK)

			goto (endofpetalburgriotscript)


		}

		if (var(VAR_RESULT) == 3) {

		setvar (VAR_PETALBURG_RIOT_POSITION, 0)
		goto (endofpetalburgriotscript)

		}

endofpetalburgriotscript:

		closemessage
		fadeoutbgm (1)
		fadeinbgm (1)

		gettimeofday
		if (var(VAR_0x8000) == TIME_MORNING)
		{playbgm (MUS_TEAMGRDUEL, TRUE)}

		if (var(VAR_0x8000) == TIME_DAY)
		{playbgm (MUS_TEAMGRDUEL, TRUE)}

		if (var(VAR_0x8000) == TIME_EVENING)
		{playbgm (MUS_PANULACAVE, TRUE)}

		if (var(VAR_0x8000) == TIME_NIGHT)
		{playbgm (MUS_PANULACAVE, TRUE)}

release
}

