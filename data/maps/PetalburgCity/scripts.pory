		"Willneverplay"}

	text Dawson_Outro{
		"And thus Hoenn plunges further into\nchaos..."}

	text Georgia_Outro{
		"Tsk... we'll never give up!!"}

	text Georgia_MultiOutro{
		"Tsk... only lost cause this guy\ndragged me down!!"}

	text Dawson_MultiOutro{
		"You are quite strong. You would make\nan excellent Devon Grunt."}





script PetalburgRiotBatter {
