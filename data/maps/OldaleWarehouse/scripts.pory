script OldaleWarehouseCarRebel2 {

	if (!flag (carrebelwarehouse))
	{lock
	playbgm (MUS_MONSTERHOUSE, TRUE)
	setflag (FLAG_SAFE_FOLLOWER_MOVEMENT)
    msgbox (format("Hey, YOU!"))
    playse (SE_FLEE)
	addobject (6)
	applymovement (6, moves(walk_fast_right * 1, walk_fast_up * 5))
	waitmovement (6)
    msgbox (format("You're in deep trouble now! My Electrike is in TOP SHAPE!"))
	playse (SE_BALL_OPEN)
	addobject (7)
	setobjectxy (7, 7, 7)
	goto (continuewarehousecarrrebel)}
}

script OldaleWarehouseCarRebel {

	if (!flag (carrebelwarehouse))
	{lock
	playbgm (MUS_MONSTERHOUSE, TRUE)
	setflag (FLAG_SAFE_FOLLOWER_MOVEMENT)
    msgbox (format("Hey, YOU!"))
	closemessage
    playse (SE_FLEE)
	addobject (6)
	applymovement (6, moves(walk_fast_up * 5))
	waitmovement (6)
    msgbox (format("You're in deep trouble now! My Electrike is in TOP SHAPE!"))
	closemessage
	playse (SE_BALL_OPEN)
	addobject (7)
	setobjectxy (7, 6, 7)
	continuewarehousecarrrebel:
	waitse
	applymovement (7, moves(walk_in_place_fast_up * 5))
	playmoncry (SPECIES_ELECTRIKE, CRY_MODE_HIGH_PITCH)
	waitmovement (7)
    msgbox (format("IIIIIKE!"))
	if (flag(FLAG_SYS_POKEDEX_GET))
	{setseenmon (SPECIES_ELECTRIKE)}
	closemessage
	fadeoutbgm (3)
	playse (SE_M_TWISTER)
	waitse
	playse (SE_M_METRONOME)
	applymovement (6, moves(emote_question_mark, walk_in_place_right, walk_in_place_left, walk_in_place_right, walk_in_place_left, walk_in_place_down))
	waitse
    msgbox (format("Wait... where's everyone?"))
	applymovement (6, moves(walk_in_place_up))
    msgbox (format("Oh... you beat them? And they just... left? Without telling me?"))

	playmoncry (SPECIES_ELECTRIKE, CRY_MODE_WEAK)
	applymovement (7, moves(walk_in_place_down))
    msgbox (format("Iiike..."))

	applymovement (6, moves(walk_in_place_up))
    msgbox (format("... wow, what a bunch of losers - right, Ike?"))
	applymovement (6, moves(walk_in_place_down))
    msgbox (format("Let's go back to Petalburg, buddy. We'll make better pals."))

	playse (SE_LEDGE)
	applymovement (7, moves(jump_in_place_down * 1))
	waitse
	//playse (SE_LEDGE)
	//applymovement (7, moves(jump_in_place_up_down * 1))
	//waitse
	playmoncry (SPECIES_ELECTRIKE, CRY_MODE_NORMAL)
    msgbox (format("Iiike!"))
	closemessage
	applymovement (6, moves(walk_down * 7))

	applymovement (7, moves(walk_down * 8))
	waitmovement (6)
	playse (SE_EXIT)

	removeobject (6)
	removeobject (7)

	setflag (carrebelwarehouse)
	setflag (carrebelatDC)
	fadeinbgm (1)
	playbgm (MUS_UNDERPIZZA, TRUE)
	release}

	else {release}
	
	release
}

script DevonWarehouseWorkerLoadtad {
    lock
    setflag (FLAG_SAFE_FOLLOWER_MOVEMENT)
    msgbox (format("Easy now, boy... did the bad rebels scare you?"))
	release

}

script DevonWarehouseWorkerForklift {
    lock
    setflag (FLAG_SAFE_FOLLOWER_MOVEMENT)
    applymovement (10, moves(face_player))
    waitmovement (10)
    msgbox (format("Many forklifts have bumps all over... did they use them to race or something?
	\pTalk about childish..."))
    applymovement (10, moves(face_down))
    waitmovement (10)
    release
    
}

script WarehouseParcelNPC {
	lock
    setflag (FLAG_SAFE_FOLLOWER_MOVEMENT)
    applymovement (11, moves(face_player))
    waitmovement (11)

  	if (flag(dailyloadtadparcelquest))
	{    msgbox (format("The Loadtads are getting a bit nervous, so it's better to leave them
	alone for today.\p Come back tomorrow, if you want to help retrieve parcels again!"))
	goto (endofdevonparcelquestnpc)
	}

	else {


	if ((var(VAR_WAREHOUSEPARCELQUEST) == 0)) {

		if (flag(devondailyparcelquestexplained))
		{msgbox (format("You're back! Interested in getting parcels from Loadtads?"))}

		if (!flag(devondailyparcelquestexplained))
		{msgbox (format("Hey there! You look like a resourceful trainer. Interested in a part-time job?"))}

    
		dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "Sure", "No, thank you")
			if (var(VAR_RESULT) == 0) {
				setvar(VAR_WAREHOUSEPARCELQUEST, 1)
				if (!flag(devondailyparcelquestexplained))
				{
				msgbox (format("Great! You may have noticed, many of the Pokémon here are still
				hostile after the Rebel incident.
				\pIt's the Loadtads in particular we need to wrangle ASAP, because they are carrying
				many of our parcels, and their delivery deadlines are closing in.
				\pThat's where you come in. Get the parcels from the Loadtads - catch them,
				or snatch the parcels from them.
				\pFor every parcel you give me, I'll give you a reward. Deal?"))
				setflag (devondailyparcelquestexplained)

					dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "Sounds good", "Sounds boring")
					if (var(VAR_RESULT) == 0) {

					msgbox (format("Great! Good luck with the parcel hunt!"))
					goto (endofdevonparcelquestnpc)
					}

					if (var(VAR_RESULT) == 1) {
					msgbox (format("Boring? Buddy, work is rarely fun! That's why it's called work, and not
					... play-time!"))
					msgbox (format("Well, it's your loss. Come back if you change your mind!"))

					goto (endofdevonparcelquestnpc)
					}
				}

				if (flag(devondailyparcelquestexplained))
				{msgbox (format("Great - well, you know how it goes! Get me some of the parcels the
				Loadtads in this floor have equipped!"))
				goto (endofdevonparcelquestnpc)}
				
			}

			if (var(VAR_RESULT) == 1) {
			msgbox (format("Well, it's your loss. Come back if you change your mind!"))
			goto (endofdevonparcelquestnpc)
			}

		}

  	if ((var(VAR_WAREHOUSEPARCELQUEST) < 4 && checkitem (ITEM_PARCEL)  == FALSE))
	{
	msgbox (format("What, no luck getting those parcels yet? Try a little harder!"))
	goto (endofdevonparcelquestnpc)}
	

  	if ((var(VAR_WAREHOUSEPARCELQUEST) < 4 && checkitem (ITEM_PARCEL)  == TRUE))
	{
	
	gotparcelforparcelquest:
	msgbox (format("Hey, good job getting that parcel! Here's your reward!"))

        addvar (VAR_WAREHOUSEPARCELQUEST, + 1)
		removeitem (ITEM_PARCEL)
		random (2)
		copyvar (VAR_TEMP_1, VAR_RESULT)

		switch (var(VAR_RESULT))
		{case 0:giveitem (ITEM_ULTRA_BALL, 5)
		msgbox (format("Those are very rare balls - you won't find them sold anywhere in the Rebel Zone!"))
		case 1: giveitem (ITEM_MAX_POTION)
		msgbox (format("Very rare medicine - you won't find it sold anywhere in the Rebel Zone!"))
		goto (endofdevonparcelquestnpc)
		}

		if ((var(VAR_WAREHOUSEPARCELQUEST) == 4))
		{setvar(VAR_WAREHOUSEPARCELQUEST, 0)
		setflag (dailyloadtadparcelquest)
		goto (endofdevonparcelquestnpc)}
	}

}
	endofdevonparcelquestnpc:
    applymovement (11, moves(face_down))
    waitmovement (11)
	release
}
