//NOT USED 
script RebelHarborCartGrab {
	lock

	if (!flag(harborcartquestaccepted))
		{	
		msgbox(format("It's a platform trolley."))	
		}

	if (flag(harborcartquestaccepted))
		{	
		msgbox(format("{PLAYER} is using the platform trolley."))
		setfollowernpc (LOCALID_REBELHARBOR_EMPTYCART, FNPC_ALL, RebelHarborCartFollow, PARTNER_RIVAL_FEMALE)
		}


	release
}